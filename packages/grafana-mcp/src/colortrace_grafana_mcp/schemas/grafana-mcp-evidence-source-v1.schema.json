{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colortrace.dev/schemas/grafana-mcp-evidence-source-v1.schema.json",
  "title": "Official Grafana MCP evidence source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "server",
    "server_version",
    "server_commit",
    "binary_sha256",
    "mcp_sdk_version",
    "mcp_protocol_version",
    "tool",
    "tool_input_schema_sha256",
    "tool_annotations_sha256",
    "inventory_version"
  ],
  "properties": {
    "kind": {"const": "grafana-mcp"},
    "server": {"const": "mcp-grafana"},
    "server_version": {"const": "1.1.0"},
    "server_commit": {"const": "007e8d82154899a28e19e8dfe9c2bb4452c5211a"},
    "binary_sha256": {"const": "7b4f978ee4e31053cad3392626b6896d3da2315d5e6b2bcbba815c9b04872236"},
    "mcp_sdk_version": {"const": "1.29.0"},
    "mcp_protocol_version": {"const": "2025-06-18"},
    "tool": {
      "enum": [
        "alerting_manage_rules",
        "query_loki_logs",
        "query_prometheus",
        "tempo_get-trace"
      ]
    },
    "tool_input_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tool_annotations_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inventory_version": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
