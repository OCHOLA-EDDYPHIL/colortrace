{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colortrace.dev/schemas/fixture-runtime-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "fixture_id", "fixture_version", "variant_id", "run_id", "seed_sha256", "schedule_origin", "image_generator", "float_buffer", "comparison_policy", "ocio_version", "worker_configs", "sources", "jobs", "lineage", "telemetry", "provenance", "declared_resources"],
  "properties": {
    "schema": {"const": "fixture-runtime-manifest/v1"},
    "fixture_id": {"type": "string", "minLength": 1},
    "fixture_version": {"const": "colortrace-fixture/v1"},
    "variant_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "seed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schedule_origin": {"type": "string", "format": "date-time"},
    "image_generator": {"const": "generated-chart/v1"},
    "float_buffer": {"const": "rgb-float32-buffer/v1"},
    "comparison_policy": {"const": "declared-reference-comparison/v1"},
    "ocio_version": {"const": "2.5.2"},
    "worker_configs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/worker"}},
    "sources": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/indexed"}},
    "jobs": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/indexedJob"}},
    "lineage": {"$ref": "#/$defs/pointer"},
    "telemetry": {"$ref": "#/$defs/pointer"},
    "provenance": {"$ref": "#/$defs/pointer"},
    "declared_resources": {"$ref": "#/$defs/pointer"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pointer": {"type": "object", "additionalProperties": false, "required": ["manifest", "sha256"], "properties": {"manifest": {"type": "string"}, "sha256": {"$ref": "#/$defs/digest"}}},
    "indexed": {"type": "object", "additionalProperties": false, "required": ["source_id", "manifest", "sha256"], "properties": {"source_id": {"type": "string"}, "manifest": {"type": "string"}, "sha256": {"$ref": "#/$defs/digest"}}},
    "indexedJob": {"type": "object", "additionalProperties": false, "required": ["job_id", "manifest", "sha256"], "properties": {"job_id": {"type": "string"}, "manifest": {"type": "string"}, "sha256": {"$ref": "#/$defs/digest"}}},
    "worker": {"type": "object", "additionalProperties": false, "required": ["worker_id", "config_sha256", "config"], "properties": {"worker_id": {"type": "string"}, "config_sha256": {"$ref": "#/$defs/digest"}, "config": {"type": "string"}}}
  }
}
