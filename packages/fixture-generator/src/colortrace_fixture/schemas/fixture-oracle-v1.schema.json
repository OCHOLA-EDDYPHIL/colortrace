{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colortrace.dev/schemas/fixture-oracle-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "fixture_id", "variant_id", "seed", "role_to_job_id", "directly_affected_jobs", "safe_jobs", "affected_derivatives", "causal_resource_sha256", "approved_resource_sha256", "non_causal_event_id", "rejected_causes", "expected_unresolved_jobs"],
  "properties": {
    "schema": {"const": "fixture-oracle/v1"}, "fixture_id": {"const": "ct-shadowed-lut-v1"}, "variant_id": {"type": "string"}, "seed": {"type": "string"},
    "role_to_job_id": {"type": "object", "additionalProperties": {"type": "string"}, "required": ["a1", "a2", "b1", "b2", "b3", "b4"]},
    "directly_affected_jobs": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}, "uniqueItems": true}, "safe_jobs": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}, "uniqueItems": true}, "affected_derivatives": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}},
    "causal_resource_sha256": {"$ref": "#/$defs/digest"}, "approved_resource_sha256": {"$ref": "#/$defs/digest"}, "non_causal_event_id": {"type": "string"}, "rejected_causes": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object"}}, "expected_unresolved_jobs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
