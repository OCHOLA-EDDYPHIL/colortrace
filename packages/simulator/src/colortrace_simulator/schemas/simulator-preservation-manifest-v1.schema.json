{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colortrace.dev/schemas/simulator-preservation-manifest-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "fixture_id", "baseline_pointer_sha256", "baseline_generation", "fixture_manifest_sha256", "runtime_manifest_sha256", "lineage_manifest_sha256", "command_intent_sha256", "targets_sha256", "exclusions_sha256", "mutable_entries", "metadata_reseal_paths", "allowed_additions", "target_invariants", "safe_complement_sha256"],
  "properties": {
    "schema": {"const": "simulator-preservation-manifest/v1"}, "fixture_id": {"type": "string"}, "baseline_pointer_sha256": {"$ref": "#/$defs/digest"}, "baseline_generation": {"type": "integer", "minimum": 1},
    "fixture_manifest_sha256": {"$ref": "#/$defs/digest"}, "runtime_manifest_sha256": {"$ref": "#/$defs/digest"}, "lineage_manifest_sha256": {"$ref": "#/$defs/digest"}, "command_intent_sha256": {"$ref": "#/$defs/digest"}, "targets_sha256": {"$ref": "#/$defs/digest"}, "exclusions_sha256": {"$ref": "#/$defs/digest"},
    "mutable_entries": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "object"}},
    "metadata_reseal_paths": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}},
    "allowed_additions": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object"}},
    "target_invariants": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object"}},
    "safe_complement_sha256": {"$ref": "#/$defs/digest"}
  }, "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
