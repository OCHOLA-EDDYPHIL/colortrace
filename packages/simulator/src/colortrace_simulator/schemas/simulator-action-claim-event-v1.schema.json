{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colortrace.dev/schemas/simulator-action-claim-event-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema", "event_id", "action_id", "sequence", "event_type", "owner",
    "generation", "lease_expires_at", "predecessor_event_sha256", "occurred_at",
    "event_sha256"
  ],
  "properties": {
    "schema": {"const": "simulator-action-claim-event/v1"},
    "event_id": {"type": "string", "pattern": "^simulator-claim-event:[0-9a-f]{64}$"},
    "action_id": {"type": "string", "pattern": "^simulator-action:[0-9a-f]{64}$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 4096},
    "event_type": {"enum": ["claim.acquired", "claim.reclaimed", "claim.renewed", "claim.cancelled", "claim.completed"]},
    "owner": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "generation": {"type": "integer", "minimum": 1},
    "lease_expires_at": {"type": "string", "format": "date-time"},
    "predecessor_event_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "event_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
