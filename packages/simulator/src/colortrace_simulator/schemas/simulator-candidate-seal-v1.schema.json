{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colortrace.dev/schemas/simulator-candidate-seal-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "operation_id", "publication_id", "predecessor_pointer", "predecessor_pointer_sha256", "predecessor_generation", "candidate_generation", "source_batch_id", "source_batch_sha256", "fixture_manifest_sha256", "runtime_manifest_sha256", "lineage_manifest_sha256", "declared_resource_manifest_sha256", "preservation_manifest_sha256", "safe_complement_before_sha256", "safe_complement_after_sha256", "safe_complement_proof_sha256", "commands_sha256", "targets_sha256", "exclusions_sha256", "candidate_tree_sha256", "quarantine", "command_results", "prepared_at"],
  "properties": {
    "schema": {"const": "simulator-candidate-seal/v1"}, "operation_id": {"type": "string"}, "publication_id": {"type": "string"}, "predecessor_pointer": {"type": "object"}, "predecessor_pointer_sha256": {"$ref": "#/$defs/digest"}, "predecessor_generation": {"type": "integer", "minimum": 1}, "candidate_generation": {"type": "integer", "minimum": 2},
    "source_batch_id": {"type": "string"}, "source_batch_sha256": {"$ref": "#/$defs/digest"}, "fixture_manifest_sha256": {"$ref": "#/$defs/digest"}, "runtime_manifest_sha256": {"$ref": "#/$defs/digest"}, "lineage_manifest_sha256": {"$ref": "#/$defs/digest"}, "declared_resource_manifest_sha256": {"$ref": "#/$defs/digest"}, "preservation_manifest_sha256": {"$ref": "#/$defs/digest"}, "safe_complement_before_sha256": {"$ref": "#/$defs/digest"}, "safe_complement_after_sha256": {"$ref": "#/$defs/digest"}, "safe_complement_proof_sha256": {"$ref": "#/$defs/digest"}, "commands_sha256": {"$ref": "#/$defs/digest"}, "targets_sha256": {"$ref": "#/$defs/digest"}, "exclusions_sha256": {"$ref": "#/$defs/digest"}, "candidate_tree_sha256": {"$ref": "#/$defs/digest"}, "quarantine": {"type": "object"}, "command_results": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object"}}, "prepared_at": {"type": "string", "format": "date-time"}
  }, "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
