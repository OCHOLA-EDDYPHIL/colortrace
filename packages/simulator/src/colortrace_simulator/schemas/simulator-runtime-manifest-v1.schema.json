{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colortrace.dev/schemas/simulator-runtime-manifest-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "fixture_id", "generation", "source_batch_id", "source_batch_sha256", "source_fixture_manifest_sha256", "previous_runtime_manifest_sha256", "declared_resource_manifest_sha256", "ocio_version", "resources", "frames", "derivatives", "lineage", "files"],
  "properties": {
    "schema": {"const": "simulator-runtime-manifest/v1"},
    "fixture_id": {"$ref": "#/$defs/id"}, "generation": {"type": "integer", "minimum": 1},
    "source_batch_id": {"$ref": "#/$defs/id"}, "source_batch_sha256": {"$ref": "#/$defs/digest"},
    "source_fixture_manifest_sha256": {"$ref": "#/$defs/digest"},
    "previous_runtime_manifest_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "declared_resource_manifest_sha256": {"$ref": "#/$defs/digest"}, "ocio_version": {"const": "2.5.2"},
    "resources": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object"}},
    "frames": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "object"}},
    "derivatives": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object"}},
    "lineage": {"$ref": "#/$defs/pointer"},
    "files": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/file"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$"},
    "pointer": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/digest"}}},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size", "kind"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/digest"}, "size": {"type": "integer", "minimum": 0}, "kind": {"enum": ["config", "resource", "frame-output", "frame-display", "derivative-output", "derivative-display", "lineage", "quarantine"]}}}
  }
}
