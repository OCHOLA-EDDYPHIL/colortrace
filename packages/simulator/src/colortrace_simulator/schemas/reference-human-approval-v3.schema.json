{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colortrace.dev/schemas/reference-human-approval-v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "decision", "approver", "approval_nonce", "issued_at", "expires_at",
    "action_intent_id", "action_intent_sha256", "reconciliation_id", "scenario_id",
    "incident_class", "command", "affected_job_ids", "state_generation",
    "state_sha256", "protected_state_sha256", "approval_id", "approval_sha256"
  ],
  "properties": {
    "schema": {"const": "reference-human-approval/v3"},
    "decision": {"enum": ["approved", "denied"]},
    "approver": {
      "type": "object", "additionalProperties": false,
      "required": ["audience", "kind", "identity_verified", "identity_assurance"],
      "properties": {
        "audience": {"$ref": "#/$defs/id"},
        "kind": {"const": "human"},
        "identity_verified": {"type": "boolean"},
        "identity_assurance": {
          "enum": ["verified-identity", "unverified-public-demo-gesture"]
        },
        "identity": {
          "type": "object", "additionalProperties": false,
          "required": ["issuer", "subject"],
          "properties": {
            "issuer": {"type": "string", "minLength": 1, "maxLength": 512},
            "subject": {"$ref": "#/$defs/id"}
          }
        },
        "gesture": {"const": "explicit-phrase-and-nonce"}
      },
      "oneOf": [
        {
          "required": ["identity"],
          "properties": {
            "identity_verified": {"const": true},
            "identity_assurance": {"const": "verified-identity"}
          },
          "not": {"required": ["gesture"]}
        },
        {
          "required": ["gesture"],
          "properties": {
            "identity_verified": {"const": false},
            "identity_assurance": {"const": "unverified-public-demo-gesture"}
          },
          "not": {"required": ["identity"]}
        }
      ]
    },
    "approval_nonce": {"$ref": "#/$defs/id"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "action_intent_id": {"type": "string", "pattern": "^action-intent:[0-9a-f]{64}$"},
    "action_intent_sha256": {"$ref": "#/$defs/digest"},
    "reconciliation_id": {"type": "string", "pattern": "^diagnosis-reconciliation:[0-9a-f]{64}$"},
    "scenario_id": {"$ref": "#/$defs/id"},
    "incident_class": {"$ref": "#/$defs/incident"},
    "command": {"enum": ["reconcile-resource", "pin-rollout", "invalidate-cache"]},
    "affected_job_ids": {"$ref": "#/$defs/idList"},
    "state_generation": {"type": "integer", "minimum": 1},
    "state_sha256": {"$ref": "#/$defs/digest"},
    "protected_state_sha256": {"$ref": "#/$defs/digest"},
    "approval_id": {"type": "string", "pattern": "^reference-approval:[0-9a-f]{64}$"},
    "approval_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "incident": {
      "enum": [
        "resource-resolution-drift/v1", "configuration-rollout-drift/v1",
        "stale-derivative-cache/v1"
      ]
    },
    "idList": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    }
  }
}
