{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colortrace.dev/schemas/simulator-publication-pointer-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "namespace", "publication_id", "fixture_id", "generation", "source_batch_id", "source_batch_sha256", "fixture_manifest_sha256", "runtime_manifest_sha256", "lineage_manifest_sha256", "declared_resource_manifest_sha256", "ocio_version", "candidate_seal_sha256", "previous_pointer_sha256", "operation_id", "prepared_at"],
  "properties": {
    "schema": {"const": "simulator-publication-pointer/v1"}, "namespace": {"const": "colortrace-simulator"}, "publication_id": {"type": "string", "pattern": "^publication:[0-9a-f]{64}$"}, "fixture_id": {"type": "string"}, "generation": {"type": "integer", "minimum": 1}, "source_batch_id": {"type": "string"}, "source_batch_sha256": {"$ref": "#/$defs/digest"}, "fixture_manifest_sha256": {"$ref": "#/$defs/digest"}, "runtime_manifest_sha256": {"$ref": "#/$defs/digest"}, "lineage_manifest_sha256": {"$ref": "#/$defs/digest"}, "declared_resource_manifest_sha256": {"$ref": "#/$defs/digest"}, "ocio_version": {"const": "2.5.2"}, "candidate_seal_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}, "previous_pointer_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}, "operation_id": {"type": ["string", "null"]}, "prepared_at": {"type": "string", "format": "date-time"}
  }, "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
