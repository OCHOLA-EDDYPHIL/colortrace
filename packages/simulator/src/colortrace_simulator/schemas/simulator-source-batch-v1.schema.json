{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colortrace.dev/schemas/simulator-source-batch-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_batch_id", "fixture_id", "fixture_version", "variant_id", "run_id", "source_fixture_manifest", "ocio_version", "declared_resource_manifest", "lineage", "sources", "jobs", "derivatives", "approved_resource", "files"],
  "properties": {
    "schema": {"const": "simulator-source-batch/v1"},
    "source_batch_id": {"$ref": "#/$defs/id"},
    "fixture_id": {"$ref": "#/$defs/id"},
    "fixture_version": {"const": "colortrace-fixture/v1"},
    "variant_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "source_fixture_manifest": {"$ref": "#/$defs/pointer"},
    "ocio_version": {"const": "2.5.2"},
    "declared_resource_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "logical_path", "approved_resource_sha256", "nominal_config_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/digest"},
        "logical_path": {"const": "luts/show_look.cube"},
        "approved_resource_sha256": {"$ref": "#/$defs/digest"},
        "nominal_config_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "lineage": {"$ref": "#/$defs/pointer"},
    "sources": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object"}},
    "jobs": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "object"}},
    "derivatives": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object"}},
    "approved_resource": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/digest"}, "size": {"type": "integer", "minimum": 1}}
    },
    "files": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/file"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$"},
    "pointer": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/digest"}}},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size", "kind"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/digest"}, "size": {"type": "integer", "minimum": 0}, "kind": {"type": "string", "enum": ["runtime", "reference", "approved-object"]}}}
  }
}
