{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate",
    "started_at",
    "finished_at",
    "grafana_read_calls",
    "expected",
    "observed",
    "decisive_operational_facts",
    "limitations"
  ],
  "properties": {
    "schema": {"const": "manual-no-gemini-observation/v1"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "grafana_read_calls": {"type": "integer", "minimum": 0, "maximum": 64},
    "expected": {"$ref": "#/$defs/assessment"},
    "observed": {"$ref": "#/$defs/assessment"},
    "decisive_operational_facts": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["frame", "derivative"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["causal_resource_sha256", "affected", "safe"],
      "properties": {
        "causal_resource_sha256": {"$ref": "#/$defs/digest"},
        "affected": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/target"}},
        "safe": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/target"}}
      }
    }
  }
}
