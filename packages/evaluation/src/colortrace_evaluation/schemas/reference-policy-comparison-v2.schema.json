{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colortrace.dev/schemas/reference-policy-comparison-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "corpus_id", "corpus_sha256", "budget", "budget_comparison",
    "candidate", "baseline", "adaptive_advantage_basis_points",
    "recorded_model_output_evaluated", "recorded_model_advantage_basis_points",
    "predeclared_minimum_recorded_model_advantage_basis_points",
    "checks", "report_sha256"
  ],
  "properties": {
    "schema": {"const": "reference-policy-comparison/v2"},
    "corpus_id": {"$ref": "#/$defs/id"},
    "corpus_sha256": {"$ref": "#/$defs/digest"},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_queries_per_case", "max_normalized_bytes_per_case"],
      "properties": {
        "max_queries_per_case": {"type": "integer", "minimum": 2},
        "max_normalized_bytes_per_case": {"type": "integer", "minimum": 1}
      }
    },
    "budget_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["same_query_budget", "same_normalized_byte_budget"],
      "properties": {
        "same_query_budget": {"const": true},
        "same_normalized_byte_budget": {"const": true}
      }
    },
    "candidate": {"$ref": "#/$defs/policy"},
    "baseline": {"$ref": "#/$defs/policy"},
    "adaptive_advantage_basis_points": {
      "type": "integer", "minimum": -10000, "maximum": 10000
    },
    "recorded_model_output_evaluated": {"type": "boolean"},
    "recorded_model_advantage_basis_points": {
      "oneOf": [
        {"type": "null"},
        {"type": "integer", "minimum": -10000, "maximum": 10000}
      ]
    },
    "predeclared_minimum_recorded_model_advantage_basis_points": {"const": 1},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_within_budget", "baseline_within_budget",
        "recorded_model_output_evaluated", "measurable_candidate_advantage",
        "zero_false_authorized_actions"
      ],
      "properties": {
        "candidate_within_budget": {"type": "boolean"},
        "baseline_within_budget": {"type": "boolean"},
        "recorded_model_output_evaluated": {"type": "boolean"},
        "measurable_candidate_advantage": {"type": "boolean"},
        "zero_false_authorized_actions": {"type": "boolean"}
      }
    },
    "report_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "queryKey": {
      "enum": [
        "metric.correlated-observations", "log.correlated-events", "trace.by-id"
      ]
    },
    "incidentOrNull": {
      "oneOf": [
        {"type": "null"},
        {
          "enum": [
            "resource-resolution-drift/v1", "configuration-rollout-drift/v1",
            "stale-derivative-cache/v1"
          ]
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id", "trace_sha256", "selection_input_sha256", "selected_query_keys",
        "normalized_bytes", "resolved_correctly", "reconciliation_id", "status",
        "incident_class"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "trace_sha256": {"$ref": "#/$defs/digest"},
        "selection_input_sha256": {"$ref": "#/$defs/digest"},
        "selected_query_keys": {
          "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
          "items": {"$ref": "#/$defs/queryKey"}
        },
        "normalized_bytes": {"type": "integer", "minimum": 1},
        "resolved_correctly": {"type": "boolean"},
        "reconciliation_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["supported", "rejected", "insufficient", "conflicting"]},
        "incident_class": {"$ref": "#/$defs/incidentOrNull"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id", "source", "case_count", "correct_resolutions",
        "accuracy_basis_points", "false_authorized_actions", "total_queries",
        "total_normalized_bytes", "maximum_case_normalized_bytes",
        "recorded_receipt_set_sha256", "recorded_receipt_count", "results"
      ],
      "properties": {
        "policy_id": {"$ref": "#/$defs/id"},
        "source": {"enum": ["controlled-policy", "recorded-model-output"]},
        "case_count": {"type": "integer", "minimum": 1},
        "correct_resolutions": {"type": "integer", "minimum": 0},
        "accuracy_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
        "false_authorized_actions": {"type": "integer", "minimum": 0},
        "total_queries": {"type": "integer", "minimum": 1},
        "total_normalized_bytes": {"type": "integer", "minimum": 1},
        "maximum_case_normalized_bytes": {"type": "integer", "minimum": 1},
        "recorded_receipt_set_sha256": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
        },
        "recorded_receipt_count": {"type": "integer", "minimum": 0},
        "results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/result"}}
      }
    }
  }
}
