{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "plan_sha256", "spec_id", "candidate", "outcome", "attempt", "retry_count", "trace_correlation_failure", "unsupported_diagnoses", "unauthorized_actions", "duplicate_actions", "primary_action_count", "replay_action_count", "sources"],
  "properties": {
    "schema": {"const": "reliability-run-observation/v1"},
    "plan_sha256": {"$ref": "#/$defs/digest"},
    "spec_id": {"type": "string", "pattern": "^eval-[0-9]{2}$"},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["commit", "tree"], "properties": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "outcome": {"enum": ["resolved", "unresolved", "recovery-failed"]},
    "attempt": {"const": 1}, "retry_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "trace_correlation_failure": {"type": "boolean"},
    "unsupported_diagnoses": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "unauthorized_actions": {"type": "integer", "minimum": 0}, "duplicate_actions": {"type": "integer", "minimum": 0},
    "primary_action_count": {"type": "integer", "minimum": 0}, "replay_action_count": {"type": "integer", "minimum": 0},
    "sources": {"type": "object", "additionalProperties": false, "required": ["execution_sha256", "replay_sha256", "action_evidence_sha256", "recovery_aggregate_sha256"], "properties": {"execution_sha256": {"$ref": "#/$defs/digest"}, "replay_sha256": {"$ref": "#/$defs/digest"}, "action_evidence_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}, "recovery_aggregate_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}}}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
