{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "candidate", "campaign_seed", "created_at", "attempt_policy", "thresholds", "specs", "plan_id", "sha256"],
  "properties": {
    "schema": {"const": "reliability-campaign-plan/v1"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "campaign_seed": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"},
    "attempt_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["attempts_per_spec", "hidden_retries"],
      "properties": {"attempts_per_spec": {"const": 1}, "hidden_retries": {"const": false}}
    },
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["root_cause_accuracy_numerator", "root_cause_accuracy_denominator", "affected_precision_numerator", "affected_precision_denominator", "affected_recall_numerator", "affected_recall_denominator", "safe_precision_numerator", "safe_precision_denominator", "safe_recall_numerator", "safe_recall_denominator", "maximum_trace_correlation_failures", "maximum_unsupported_diagnoses", "maximum_unauthorized_actions", "maximum_duplicate_actions"],
      "properties": {
        "root_cause_accuracy_numerator": {"const": 1}, "root_cause_accuracy_denominator": {"const": 1},
        "affected_precision_numerator": {"const": 1}, "affected_precision_denominator": {"const": 1},
        "affected_recall_numerator": {"const": 1}, "affected_recall_denominator": {"const": 1},
        "safe_precision_numerator": {"const": 1}, "safe_precision_denominator": {"const": 1},
        "safe_recall_numerator": {"const": 1}, "safe_recall_denominator": {"const": 1},
        "maximum_trace_correlation_failures": {"const": 1},
        "maximum_unsupported_diagnoses": {"const": 0},
        "maximum_unauthorized_actions": {"const": 0},
        "maximum_duplicate_actions": {"const": 0}
      }
    },
    "specs": {"type": "array", "minItems": 50, "maxItems": 50, "items": {"$ref": "#/$defs/spec"}},
    "plan_id": {"type": "string", "pattern": "^reliability-plan:[0-9a-f]{64}$"},
    "sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["commit", "tree"], "properties": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["spec_id", "family", "variant", "seed", "sample_index", "expected_outcome", "evidence_case", "recovery_case", "coverage", "order_key", "execution_order"],
      "properties": {
        "spec_id": {"type": "string", "pattern": "^eval-[0-9]{2}$"},
        "family": {"enum": ["canonical", "hidden", "missing-resource", "missing-reference", "recovery-failure"]},
        "variant": {"enum": ["canonical", "hidden-permuted"]},
        "seed": {"type": "string", "minLength": 1, "maxLength": 256},
        "sample_index": {"type": "integer", "minimum": 1, "maximum": 20},
        "expected_outcome": {"enum": ["resolved", "unresolved", "recovery-failed"]},
        "evidence_case": {"enum": ["complete", "missing-resource", "missing-reference"]},
        "recovery_case": {"enum": ["success", "verification-failure"]},
        "coverage": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"}},
        "order_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "execution_order": {"type": "integer", "minimum": 1, "maximum": 50}
      }
    }
  }
}
