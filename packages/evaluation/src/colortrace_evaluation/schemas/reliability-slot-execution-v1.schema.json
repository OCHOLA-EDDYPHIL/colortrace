{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "plan_sha256", "spec_id", "execution_order", "candidate", "started_at", "finished_at", "elapsed_ms", "timeout_seconds", "process_invocations", "timed_out", "exit_code", "outcome", "model_invocations", "transparent_transient_retries", "bindings", "artifacts"],
  "properties": {
    "schema": {"const": "reliability-slot-execution/v1"},
    "plan_sha256": {"$ref": "#/$defs/digest"},
    "spec_id": {"type": "string", "pattern": "^eval-[0-9]{2}$"},
    "execution_order": {"type": "integer", "minimum": 1, "maximum": 50},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["commit", "tree"], "properties": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "started_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": "string", "format": "date-time"},
    "elapsed_ms": {"type": "integer", "minimum": 0, "maximum": 300000},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 180},
    "process_invocations": {"const": 1}, "timed_out": {"type": "boolean"},
    "exit_code": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0, "maximum": 255}]},
    "outcome": {"enum": ["complete", "failed"]},
    "model_invocations": {"type": "integer", "minimum": 0, "maximum": 3},
    "transparent_transient_retries": {"type": "integer", "minimum": 0, "maximum": 1},
    "bindings": {"type": "object", "additionalProperties": false, "required": ["model_profile_sha256", "investigation_policy_sha256", "query_catalog_sha256", "mcp_lock_sha256", "mcp_binary_sha256", "child_python_sha256", "child_pythonpath_sha256", "project_id_sha256", "grafana_url_sha256"], "properties": {"model_profile_sha256": {"$ref": "#/$defs/digest"}, "investigation_policy_sha256": {"$ref": "#/$defs/digest"}, "query_catalog_sha256": {"$ref": "#/$defs/digest"}, "mcp_lock_sha256": {"$ref": "#/$defs/digest"}, "mcp_binary_sha256": {"$ref": "#/$defs/digest"}, "child_python_sha256": {"$ref": "#/$defs/digest"}, "child_pythonpath_sha256": {"$ref": "#/$defs/digest"}, "project_id_sha256": {"$ref": "#/$defs/digest"}, "grafana_url_sha256": {"$ref": "#/$defs/digest"}}},
    "artifacts": {"type": "object", "additionalProperties": false, "required": ["alert", "database", "packet", "replay", "stdout", "stderr"], "properties": {"alert": {"$ref": "#/$defs/artifact"}, "database": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]}, "packet": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]}, "replay": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]}, "stdout": {"$ref": "#/$defs/artifact"}, "stderr": {"$ref": "#/$defs/artifact"}}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 512}, "sha256": {"$ref": "#/$defs/digest"}}}
  }
}
