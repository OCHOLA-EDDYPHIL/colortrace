{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colortrace.dev/schemas/response-plan-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_id",
    "incident_id",
    "incident_version",
    "version",
    "previous_plan_sha256",
    "response_packet_id",
    "response_packet_sha256",
    "deterministic_scope_sha256",
    "targets",
    "exclusions",
    "commands",
    "unresolved_item_ids",
    "blocking_unresolved_item_ids",
    "unknown_target_ids",
    "unresolved_acknowledged",
    "created_by",
    "created_at",
    "plan_sha256"
  ],
  "properties": {
    "schema": {"const": "response-plan/v1"},
    "plan_id": {"type": "string", "pattern": "^response-plan:[0-9a-f]{64}$"},
    "incident_id": {"$ref": "#/$defs/identifier"},
    "incident_version": {"type": "integer", "minimum": 1},
    "version": {"type": "integer", "minimum": 1},
    "previous_plan_sha256": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
    },
    "response_packet_id": {"type": "string", "pattern": "^response-packet:[0-9a-f]{64}$"},
    "response_packet_sha256": {"$ref": "#/$defs/digest"},
    "deterministic_scope_sha256": {"$ref": "#/$defs/digest"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/target"}
    },
    "exclusions": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/target"}
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "simulator-command-v1.schema.json"}
    },
    "unresolved_item_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "blocking_unresolved_item_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "unknown_target_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "unresolved_acknowledged": {"type": "boolean"},
    "created_by": {"$ref": "#/$defs/actor"},
    "created_at": {"type": "string", "format": "date-time"},
    "plan_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "namespace", "kind", "id"],
      "properties": {
        "schema": {"const": "simulator-target/v1"},
        "namespace": {"const": "colortrace-simulator"},
        "kind": {"enum": ["color-resource", "frame", "derivative"]},
        "id": {"$ref": "#/$defs/identifier"}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "subject", "audience", "kind"],
      "properties": {
        "issuer": {"type": "string", "minLength": 1, "maxLength": 512},
        "subject": {"type": "string", "minLength": 1, "maxLength": 255},
        "audience": {"type": "string", "minLength": 1, "maxLength": 255},
        "kind": {"enum": ["human", "service"]}
      }
    }
  }
}
