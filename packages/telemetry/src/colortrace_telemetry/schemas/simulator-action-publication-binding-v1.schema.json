{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colortrace.dev/schemas/simulator-action-publication-binding-v1.schema.json",
  "title": "Active publication bound to a successful simulator action",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "publication_intent_id",
    "publication_intent_sha256",
    "publication_receipt_id",
    "publication_receipt_sha256",
    "predecessor_publication_pointer_sha256",
    "predecessor_publication_generation",
    "candidate_publication_pointer_sha256",
    "candidate_publication_generation",
    "source_generation",
    "candidate_generation",
    "source_batch_id",
    "source_batch_sha256",
    "candidate_fixture_manifest_sha256",
    "candidate_runtime_manifest_sha256",
    "candidate_lineage_manifest_sha256",
    "declared_resource_manifest_sha256",
    "active_publication_pointer_sha256",
    "active_runtime_manifest_sha256",
    "preservation_manifest_sha256",
    "safe_complement_before_sha256",
    "safe_complement_after_sha256",
    "safe_complement_proof_sha256",
    "candidate_seal_sha256",
    "candidate_tree_sha256",
    "publication_promoted_at"
  ],
  "properties": {
    "schema": {"const": "simulator-action-publication-binding/v1"},
    "publication_intent_id": {"$ref": "#/$defs/identifier"},
    "publication_intent_sha256": {"$ref": "#/$defs/digest"},
    "publication_receipt_id": {"$ref": "#/$defs/identifier"},
    "publication_receipt_sha256": {"$ref": "#/$defs/digest"},
    "predecessor_publication_pointer_sha256": {"$ref": "#/$defs/digest"},
    "predecessor_publication_generation": {"type": "integer", "minimum": 1},
    "candidate_publication_pointer_sha256": {"$ref": "#/$defs/digest"},
    "candidate_publication_generation": {"type": "integer", "minimum": 1},
    "source_generation": {"type": "integer", "minimum": 1},
    "candidate_generation": {"type": "integer", "minimum": 1},
    "source_batch_id": {"$ref": "#/$defs/identifier"},
    "source_batch_sha256": {"$ref": "#/$defs/digest"},
    "candidate_fixture_manifest_sha256": {"$ref": "#/$defs/digest"},
    "candidate_runtime_manifest_sha256": {"$ref": "#/$defs/digest"},
    "candidate_lineage_manifest_sha256": {"$ref": "#/$defs/digest"},
    "declared_resource_manifest_sha256": {"$ref": "#/$defs/digest"},
    "active_publication_pointer_sha256": {"$ref": "#/$defs/digest"},
    "active_runtime_manifest_sha256": {"$ref": "#/$defs/digest"},
    "preservation_manifest_sha256": {"$ref": "#/$defs/digest"},
    "safe_complement_before_sha256": {"$ref": "#/$defs/digest"},
    "safe_complement_after_sha256": {"$ref": "#/$defs/digest"},
    "safe_complement_proof_sha256": {"$ref": "#/$defs/digest"},
    "candidate_seal_sha256": {"$ref": "#/$defs/digest"},
    "candidate_tree_sha256": {"$ref": "#/$defs/digest"},
    "publication_promoted_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
