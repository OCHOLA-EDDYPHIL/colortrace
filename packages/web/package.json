{
  "name": "@colortrace/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "biome format --write biome.json e2e index.html package.json playwright.config.ts src test tsconfig.json vite.config.ts",
    "format:check": "biome format biome.json e2e index.html package.json playwright.config.ts src test tsconfig.json vite.config.ts",
    "lint": "biome lint biome.json e2e index.html package.json playwright.config.ts src test tsconfig.json vite.config.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@colortrace/api-client": "workspace:*",
    "@colortrace/workspace-model": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "26.1.0",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
