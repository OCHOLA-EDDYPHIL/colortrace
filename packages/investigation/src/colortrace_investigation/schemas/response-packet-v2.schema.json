{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colortrace.dev/schemas/response-packet-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "packet_id", "incident_id", "version", "status", "policy_binding",
    "fixed_window", "evidence_ids", "deterministic_results", "claims", "scope",
    "invocation_records", "adaptive_trace", "hypotheses", "stop_reason", "budget_use",
    "unresolved_items", "candidate_plan", "no_action_reason", "model_advisory",
    "state_history", "finalized_at", "derivation_sha256"
  ],
  "properties": {
    "schema": {"const": "response-packet/v2"},
    "packet_id": {"type": "string", "pattern": "^response-packet:[0-9a-f]{64}$"},
    "incident_id": {"$ref": "#/$defs/identifier"},
    "version": {"const": 2},
    "status": {"enum": ["resolved", "unresolved"]},
    "policy_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {"const": "bounded-adaptive-investigation/v1"},
        "sha256": {"$ref": "#/$defs/prefixed_digest"}
      }
    },
    "fixed_window": {"$ref": "#/$defs/fixed_window"},
    "evidence_ids": {
      "type": "array", "maxItems": 512, "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "deterministic_results": {
      "type": "array", "maxItems": 16,
      "items": {"$ref": "response-packet-v1.schema.json#/$defs/deterministic_result"}
    },
    "claims": {
      "type": "array", "maxItems": 128,
      "items": {"$ref": "response-packet-v1.schema.json#/$defs/claim"}
    },
    "scope": {"$ref": "response-packet-v1.schema.json#/$defs/scope"},
    "invocation_records": {
      "type": "array", "maxItems": 6,
      "items": {"$ref": "model-tool-invocation-v2.schema.json"}
    },
    "adaptive_trace": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {"$ref": "#/$defs/trace_entry"}
    },
    "hypotheses": {
      "type": "array", "maxItems": 4,
      "items": {"$ref": "#/$defs/hypothesis"}
    },
    "stop_reason": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "budget_use": {"$ref": "response-packet-v1.schema.json#/$defs/budget"},
    "unresolved_items": {
      "type": "array", "maxItems": 64,
      "items": {"$ref": "response-packet-v1.schema.json#/$defs/unresolved_item"}
    },
    "candidate_plan": {
      "oneOf": [{"type": "null"}, {"$ref": "response-packet-v1.schema.json#/$defs/candidate_plan"}]
    },
    "no_action_reason": {
      "oneOf": [
        {"type": "null"},
        {"enum": [
          "budget-exhausted", "contradictory-evidence", "evidence-unavailable",
          "incomplete-evidence", "invalid-intake", "model-unavailable",
          "no-affected-targets", "policy-drift", "stale-evidence", "validator-unresolved"
        ]}
      ]
    },
    "model_advisory": {
      "oneOf": [{"type": "null"}, {"$ref": "response-packet-v1.schema.json#/$defs/model_advisory"}]
    },
    "state_history": {
      "type": "array", "minItems": 2, "maxItems": 24,
      "items": {"enum": [
        "intake", "evidence", "selection", "assessment", "validation",
        "drafting", "finalization", "complete"
      ]}
    },
    "finalized_at": {"type": "string", "format": "date-time"},
    "derivation_sha256": {"$ref": "#/$defs/prefixed_digest"}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256},
    "prefixed_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "fixed_window": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end", "frozen_at"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"},
        "frozen_at": {"type": "string", "format": "date-time"}
      }
    },
    "hypothesis": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "hypothesis_key", "evidence_ids"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 4},
        "hypothesis_key": {"enum": [
          "color-resource-drift", "nominal-config-drift", "unrelated-event", "worker-only-failure"
        ]},
        "evidence_ids": {
          "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "trace_entry": {
      "type": "object", "additionalProperties": false,
      "required": [
        "sequence", "selected_by", "query_key", "selection_request_sha256",
        "selection_invocation_id", "selection_output_sha256", "evidence_id",
        "disposition", "reason_code", "validator_result_id"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0, "maximum": 4},
        "selected_by": {"enum": ["policy", "model"]},
        "query_key": {
          "oneOf": [
            {"type": "null"},
            {"enum": [
              "alert.rule", "log.correlated-events", "metric.correlated-observations",
              "trace.by-id", "metric.worker-cohort", "log.config-cohort"
            ]}
          ]
        },
        "selection_request_sha256": {"$ref": "#/$defs/prefixed_digest"},
        "selection_invocation_id": {
          "oneOf": [{"type": "null"}, {"type": "string", "pattern": "^model-invocation:[0-9a-f]{64}$"}]
        },
        "selection_output_sha256": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/prefixed_digest"}]
        },
        "evidence_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]},
        "disposition": {"enum": ["continue", "resolved", "unresolved"]},
        "reason_code": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
        "validator_result_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]}
      }
    }
  }
}
