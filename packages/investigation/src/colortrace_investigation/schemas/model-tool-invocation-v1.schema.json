{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colortrace.dev/schemas/model-tool-invocation-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "invocation_id",
    "incident_id",
    "turn_kind",
    "attempt",
    "model",
    "location",
    "framework",
    "framework_version",
    "client_version",
    "prompt_version",
    "policy_version",
    "tool_inventory_version",
    "normalized_input_sha256",
    "input_evidence_ids",
    "output_sha256",
    "latency_ms",
    "usage",
    "result_class",
    "error_code",
    "trace_id",
    "derivation_sha256"
  ],
  "properties": {
    "schema": {"const": "model-tool-invocation/v1"},
    "invocation_id": {"type": "string", "pattern": "^model-invocation:[0-9a-f]{64}$"},
    "incident_id": {"$ref": "#/$defs/identifier"},
    "turn_kind": {"enum": ["evidence-selection", "response-drafting"]},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 6},
    "model": {"const": "gemini-3.5-flash"},
    "location": {"const": "global"},
    "framework": {"const": "google-adk"},
    "framework_version": {"const": "2.6.3"},
    "client_version": {"const": "2.17.0"},
    "prompt_version": {"enum": ["evidence-selection/v1", "response-drafting/v1"]},
    "policy_version": {"const": "bounded-investigation/v1"},
    "tool_inventory_version": {
      "oneOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]
    },
    "normalized_input_sha256": {"$ref": "#/$defs/prefixed_digest"},
    "input_evidence_ids": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "output_sha256": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/prefixed_digest"}]
    },
    "latency_ms": {"type": "integer", "minimum": 0, "maximum": 120000},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens"],
      "properties": {
        "input_tokens": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]},
        "output_tokens": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]}
      }
    },
    "result_class": {"enum": ["accepted", "budget-rejected", "failed", "invalid"]},
    "error_code": {
      "oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}]
    },
    "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "derivation_sha256": {"$ref": "#/$defs/prefixed_digest"}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256},
    "prefixed_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
