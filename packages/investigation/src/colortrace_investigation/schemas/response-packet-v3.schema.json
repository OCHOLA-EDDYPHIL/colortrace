{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colortrace.dev/schemas/response-packet-v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packet_id",
    "version",
    "status",
    "incident_id",
    "scenario_id",
    "fixture_id",
    "run_id",
    "policy_binding",
    "fixed_window",
    "evidence_ids",
    "reference_evidence",
    "runtime_evidence_projection",
    "expected_state_assessment",
    "operational_evidence_assessment",
    "incident_class_assessments",
    "diagnosis_reconciliation",
    "selection_trace",
    "model_selection",
    "model_invocation",
    "agent_trace",
    "authority_policy",
    "action_intent",
    "no_action_reason",
    "finalized_at",
    "derivation_sha256"
  ],
  "properties": {
    "schema": {"const": "response-packet/v3"},
    "packet_id": {"type": "string", "pattern": "^response-packet:[0-9a-f]{64}$"},
    "version": {"const": 3},
    "status": {"enum": ["resolved", "unresolved"]},
    "incident_id": {"$ref": "#/$defs/identifier"},
    "scenario_id": {
      "enum": [
        "tos-resource-resolution-drift-v1",
        "tos-config-rollout-drift-v1",
        "tos-stale-derivative-cache-v1"
      ]
    },
    "fixture_id": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "policy_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {"const": "reference-investigation/v1"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "fixed_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      }
    },
    "evidence_ids": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/digest"}
    },
    "reference_evidence": {"type": "object"},
    "runtime_evidence_projection": {
      "oneOf": [{"type": "null"}, {"type": "object"}]
    },
    "expected_state_assessment": {"type": "object"},
    "operational_evidence_assessment": {"type": "object"},
    "incident_class_assessments": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "object"}
    },
    "diagnosis_reconciliation": {"type": "object"},
    "selection_trace": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/selection_trace_entry"}
    },
    "model_selection": {
      "oneOf": [{"type": "null"}, {"type": "object"}]
    },
    "model_invocation": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/model_invocation"}]
    },
    "agent_trace": {"$ref": "#/$defs/agent_trace"},
    "authority_policy": {
      "type": "array",
      "prefixItems": [
        {"const": "gemini-query-selection-only"},
        {"const": "grafana-read-only-evidence"},
        {"const": "deterministic-validators-authoritative"},
        {"const": "human-approval-required-for-action"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "action_intent": {
      "oneOf": [{"type": "null"}, {"type": "object"}]
    },
    "no_action_reason": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"}
      ]
    },
    "finalized_at": {"type": "string", "format": "date-time"},
    "derivation_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullable_digest": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
    },
    "selection_trace_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "selected_by",
        "query_key",
        "evidence_id",
        "disposition",
        "reason_codes",
        "operational_assessment_id",
        "reconciliation_id"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0, "maximum": 3},
        "selected_by": {"enum": ["policy", "model"]},
        "query_key": {
          "enum": [
            "alert.rule",
            "log.correlated-events",
            "metric.correlated-observations",
            "trace.by-id",
            "metric.worker-cohort",
            "log.config-cohort"
          ]
        },
        "evidence_id": {"$ref": "#/$defs/nullable_digest"},
        "disposition": {"enum": ["continue", "resolved", "unresolved"]},
        "reason_codes": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$"}
        },
        "operational_assessment_id": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^operational-assessment:[0-9a-f]{64}$"}
          ]
        },
        "reconciliation_id": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^diagnosis-reconciliation:[0-9a-f]{64}$"}
          ]
        }
      }
    },
    "model_invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "provider",
        "model",
        "prompt_version",
        "request_sha256",
        "output_sha256",
        "input_tokens",
        "output_tokens",
        "model_calls",
        "unobserved_model_calls",
        "status"
      ],
      "properties": {
        "schema": {"const": "model-tool-invocation/v3"},
        "provider": {"const": "vertex-ai"},
        "model": {"const": "gemini-3.5-flash"},
        "prompt_version": {"const": "evidence-selection/v3"},
        "request_sha256": {"$ref": "#/$defs/digest"},
        "output_sha256": {"$ref": "#/$defs/nullable_digest"},
        "input_tokens": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]},
        "output_tokens": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]},
        "model_calls": {"type": "integer", "minimum": 1, "maximum": 4},
        "unobserved_model_calls": {"type": "integer", "minimum": 0, "maximum": 4},
        "status": {"enum": ["accepted", "failed", "invalid"]}
      },
      "allOf": [
        {
          "if": {
            "required": ["unobserved_model_calls"],
            "properties": {"unobserved_model_calls": {"minimum": 1}}
          },
          "then": {
            "properties": {
              "input_tokens": {"type": "null"},
              "output_tokens": {"type": "null"}
            }
          }
        }
      ]
    },
    "agent_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "trace_id", "spans"],
      "properties": {
        "schema": {"const": "agent-trace/v2"},
        "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "spans": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sequence", "stage", "status", "duration_ms", "query_key",
              "input_tokens", "output_tokens", "attempts", "attempts_complete",
              "unobserved_model_calls", "error_code"
            ],
            "properties": {
              "sequence": {"type": "integer", "minimum": 0, "maximum": 15},
              "stage": {"enum": ["grafana", "gemini", "validator", "reconciliation"]},
              "status": {"enum": ["ok", "error", "unresolved"]},
              "duration_ms": {"type": "integer", "minimum": 0, "maximum": 120000},
              "query_key": {
                "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 64}]
              },
              "input_tokens": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]},
              "output_tokens": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]},
              "attempts": {"type": "integer", "minimum": 0, "maximum": 8},
              "attempts_complete": {"type": "boolean"},
              "unobserved_model_calls": {"type": "integer", "minimum": 0, "maximum": 4},
              "error_code": {
                "oneOf": [
                  {"type": "null"},
                  {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$"}
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "required": ["stage"],
                  "properties": {"stage": {"not": {"const": "gemini"}}}
                },
                "then": {"properties": {"unobserved_model_calls": {"const": 0}}}
              },
              {
                "if": {
                  "required": ["unobserved_model_calls"],
                  "properties": {"unobserved_model_calls": {"minimum": 1}}
                },
                "then": {
                  "properties": {
                    "input_tokens": {"type": "null"},
                    "output_tokens": {"type": "null"}
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
