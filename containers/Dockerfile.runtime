# syntax=docker/dockerfile:1.7.0@sha256:dbbd5e059e8a07ff7ea6233b213b36aa516b4c53c645f1817a4dd18b83cbea56

ARG SOURCE_DATE_EPOCH

FROM ghcr.io/astral-sh/uv@sha256:2d890623d310b57771ce840f0da5eed5fc6d657da05ffaa45d82797b53fa3abc AS uv

FROM golang@sha256:3889b425f035be855a72fb4755265311293b6d414521f0a519d819df32222d83 AS mcp-grafana
ARG SOURCE_DATE_EPOCH
ENV CGO_ENABLED=0 \
    GOARCH=amd64 \
    GOOS=linux \
    GOPROXY=https://proxy.golang.org \
    GOSUMDB=sum.golang.org \
    GOTOOLCHAIN=local
WORKDIR /build
COPY config/grafana-mcp/build/go.mod config/grafana-mcp/build/go.sum \
    config/grafana-mcp/build/modules.txt ./
ADD --checksum=sha256:91bdd1dece9d4aaaf9b5bda899d64f36ca65a37fd7511acbd6d69cd1c6ddbb59 \
    https://codeload.github.com/grafana/mcp-grafana/tar.gz/007e8d82154899a28e19e8dfe9c2bb4452c5211a \
    /tmp/mcp-grafana-source.tar.gz
RUN test "$(go version)" = "go version go1.26.6 linux/amd64" \
    && echo "85e4bf83e6c532ea5899f573889d3a81822ad9cb300b2099ffcb872a32c2f844  go.mod" | sha256sum -c - \
    && echo "20db324e5dfc00c37c078d95234924e08812d24e584c920e44f753973ba6fda3  go.sum" | sha256sum -c - \
    && echo "5ea9252de893c5cbb0d9affad74eb66f994bcb9e5b08373487b7df83608071ce  modules.txt" | sha256sum -c - \
    && echo "91bdd1dece9d4aaaf9b5bda899d64f36ca65a37fd7511acbd6d69cd1c6ddbb59  /tmp/mcp-grafana-source.tar.gz" | sha256sum -c - \
    && GODEBUG=http2client=0 go mod download all \
    && GODEBUG=http2client=0 go list -mod=readonly -m all > /tmp/modules.txt \
    && cmp modules.txt /tmp/modules.txt \
    && tar --extract --gzip --file /tmp/mcp-grafana-source.tar.gz --directory /tmp
RUN --network=none go mod verify \
    && module_root="$(go env GOMODCACHE)/github.com/grafana/mcp-grafana@v1.1.0" \
    && source_root="/tmp/mcp-grafana-007e8d82154899a28e19e8dfe9c2bb4452c5211a" \
    && find "$module_root" -type f -exec sh -eu -c 'module_root=$1; source_root=$2; shift 2; for module_file do relative=${module_file#${module_root}/}; cmp "$module_file" "$source_root/$relative"; done' sh "$module_root" "$source_root" {} + \
    && printf '%s  %s\n' \
        106c6df91baf0fcb1b771d714a20675155c4fd5f7f50939742cc4e704fb291d6 "$module_root/cmd/mcp-grafana/main.go" \
        b6b731a1998aeea4739ba7a02f01abe5824d02512b49bcdca034a51b02824764 "$module_root/observability/observability.go" \
        267a55ebe84f99a42b401128ecfd3e35081b7200e9f2753c45c35146627c2c69 "$module_root/observability/observability_test.go" \
        ff4d1a94ea75f670ae18ffb179867a8697f9dcf6308d9d930bc02d419c419072 "$module_root/tools.go" \
        | sha256sum -c - \
    && test "$(grep -Fh 'go.opentelemetry.io/otel/semconv/v1.40.0' \
        "$module_root/cmd/mcp-grafana/main.go" \
        "$module_root/observability/observability.go" \
        "$module_root/observability/observability_test.go" \
        "$module_root/tools.go" | wc -l)" -eq 5 \
    && chmod u+w \
        "$module_root/cmd/mcp-grafana/main.go" \
        "$module_root/observability/observability.go" \
        "$module_root/observability/observability_test.go" \
        "$module_root/tools.go" \
    && sed -i 's#go.opentelemetry.io/otel/semconv/v1.40.0#go.opentelemetry.io/otel/semconv/v1.41.0#g' \
        "$module_root/cmd/mcp-grafana/main.go" \
        "$module_root/observability/observability.go" \
        "$module_root/observability/observability_test.go" \
        "$module_root/tools.go" \
    && printf '%s  %s\n' \
        96287c1f971a3811900b3d219f47f6ce9a652694efffbceb1e3029e46a0627a0 "$module_root/cmd/mcp-grafana/main.go" \
        41f8bd487379fd466b8f7bc26845e245838b6bcd6b517c868fd1844a4b349ac5 "$module_root/observability/observability.go" \
        f2fe3fd272dc3d0182af3157bf4bf504e450ba11b085b7fcd95a1c881f8e8059 "$module_root/observability/observability_test.go" \
        1aafcc6fe24cef0a06f7f2725376d2fa29db8d2a828687e1e2f320b9cf82cbe0 "$module_root/tools.go" \
        | sha256sum -c - \
    && go test -count=1 github.com/grafana/mcp-grafana \
    && go test -count=1 github.com/grafana/mcp-grafana/cmd/mcp-grafana -run '^TestNewServer_' \
    && go build -trimpath -buildvcs=false -mod=readonly \
        -ldflags="-s -w -buildid= -X github.com/grafana/mcp-grafana.version=1.1.0" \
        -o /usr/local/bin/mcp-grafana \
        github.com/grafana/mcp-grafana/cmd/mcp-grafana \
    && test "$(/usr/local/bin/mcp-grafana --version)" = 1.1.0 \
    && echo "a3dacdcace8d8082dd7cb245e41be54e8da4a9375969cb39c85c420a30ea0809  /usr/local/bin/mcp-grafana" | sha256sum -c - \
    && install -m 0444 /go/pkg/mod/github.com/grafana/mcp-grafana@v1.1.0/LICENSE /tmp/mcp-grafana.LICENSE \
    && echo "6ec12926d6478d895ccec681c3739c170a88773d6c54d0a57e46682ae6f0adc0  /tmp/mcp-grafana.LICENSE" | sha256sum -c - \
    && install -m 0444 /usr/local/go/LICENSE /tmp/go.LICENSE \
    && echo "911f8f5782931320f5b8d1160a76365b83aea6447ee6c04fa6d5591467db9dad  /tmp/go.LICENSE" | sha256sum -c -

FROM python@sha256:a190708a2dec1bd18b1decb539f8e8f5407abaa9bf39cacda583f7f8c11db322 AS build
ARG SOURCE_DATE_EPOCH
COPY --from=uv /uv /uvx /usr/local/bin/
RUN apk add --no-cache build-base=0.5-r3 cmake=3.31.7-r1 git=2.49.1-r0 \
    libcrypto3=3.5.8-r0 libssl3=3.5.8-r0
WORKDIR /source
COPY pyproject.toml uv.lock LICENSE ./
COPY packages/api/pyproject.toml packages/api/pyproject.toml
COPY packages/evaluation/pyproject.toml packages/evaluation/pyproject.toml
COPY packages/fixture-generator/pyproject.toml packages/fixture-generator/pyproject.toml
COPY packages/grafana-mcp/pyproject.toml packages/grafana-mcp/pyproject.toml
COPY packages/investigation/pyproject.toml packages/investigation/pyproject.toml
COPY packages/recovery/pyproject.toml packages/recovery/pyproject.toml
COPY packages/repo-tools/pyproject.toml packages/repo-tools/pyproject.toml
COPY packages/response-plans/pyproject.toml packages/response-plans/pyproject.toml
COPY packages/simulator/pyproject.toml packages/simulator/pyproject.toml
COPY packages/telemetry/pyproject.toml packages/telemetry/pyproject.toml
COPY packages/validators/pyproject.toml packages/validators/pyproject.toml
COPY packages/vertical-slice/pyproject.toml packages/vertical-slice/pyproject.toml
ENV CMAKE_BUILD_PARALLEL_LEVEL=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_CONCURRENT_BUILDS=1 \
    UV_COMPILE_BYTECODE=0 \
    UV_LINK_MODE=copy
RUN --mount=type=cache,id=colortrace-runtime-uv,target=/root/.cache/uv,sharing=locked \
    uv sync --frozen --no-dev --no-editable --no-install-workspace --package colortrace-api
COPY packages/ packages/
RUN --mount=type=cache,id=colortrace-runtime-uv,target=/root/.cache/uv,sharing=locked \
    uv sync --frozen --no-dev --no-editable --package colortrace-api \
    && /source/.venv/bin/python \
        /source/packages/repo-tools/src/colortrace_repo/reproducible_venv.py \
        --venv /source/.venv \
    && /source/.venv/bin/python -c "import colortrace_api, colortrace_grafana_mcp, colortrace_simulator" \
    && /source/.venv/lib/python3.12/site-packages/PyOpenColorIO/bin/ocioconvert --help >/dev/null \
    && { /source/.venv/lib/python3.12/site-packages/PyOpenColorIO/bin/ociolutimage --help \
        >/dev/null || test "$?" -eq 1; } \
    && test -z "$(find /source/.venv -type f -name '*.py[co]' -print -quit)"
RUN --network=none /source/.venv/bin/colortrace-fixture generate \
        --bundle /tmp/colortrace-fixture-a \
        --oracle /tmp/colortrace-oracle-a \
        --variant canonical \
        --seed ct-shadowed-lut-v1:canonical \
    && /source/.venv/bin/colortrace-fixture generate \
        --bundle /tmp/colortrace-fixture-b \
        --oracle /tmp/colortrace-oracle-b \
        --variant canonical \
        --seed ct-shadowed-lut-v1:canonical \
    && rm -rf /tmp/colortrace-oracle-a /tmp/colortrace-oracle-b \
    && test ! -e /tmp/colortrace-oracle-a \
    && test ! -e /tmp/colortrace-oracle-b \
    && /source/.venv/bin/colortrace-fixture validate-canonical-build \
        --scenario /tmp/colortrace-fixture-a \
        --canonical-digests /source/packages/fixture-generator/fixtures/canonical-digests.json \
        --absent-oracle-root /tmp/colortrace-oracle-a \
        --absent-oracle-root /tmp/colortrace-oracle-b \
        --require-privilege-drop \
    && /source/.venv/bin/colortrace-fixture validate-canonical-build \
        --scenario /tmp/colortrace-fixture-b \
        --canonical-digests /source/packages/fixture-generator/fixtures/canonical-digests.json \
        --absent-oracle-root /tmp/colortrace-oracle-a \
        --absent-oracle-root /tmp/colortrace-oracle-b \
        --require-privilege-drop \
    && diff -qr /tmp/colortrace-fixture-a /tmp/colortrace-fixture-b \
    && test -z "$(find /tmp/colortrace-fixture-a -iname '*oracle*' -print -quit)" \
    && mv /tmp/colortrace-fixture-a /opt/colortrace-fixture \
    && rm -rf /tmp/colortrace-fixture-b

FROM python@sha256:a190708a2dec1bd18b1decb539f8e8f5407abaa9bf39cacda583f7f8c11db322 AS runtime-base
ARG SOURCE_COMMIT
ARG SOURCE_TREE
ARG SOURCE_DATE_EPOCH
ENV PYTHONDONTWRITEBYTECODE=1
RUN apk add --no-cache libcrypto3=3.5.8-r0 libssl3=3.5.8-r0 libstdc++=14.2.0-r6 \
    && case "$SOURCE_COMMIT" in (*[!0-9a-f]*|'') exit 1;; esac \
    && test "${#SOURCE_COMMIT}" = 40 \
    && case "$SOURCE_TREE" in (*[!0-9a-f]*|'') exit 1;; esac \
    && test "${#SOURCE_TREE}" = 40 \
    && case "$SOURCE_DATE_EPOCH" in (*[!0-9]*|'') exit 1;; esac \
    && addgroup -g 65532 -S colortrace \
    && adduser -u 65532 -S -D -H -h /nonexistent -s /sbin/nologin -G colortrace colortrace \
    && source_date_days=$((SOURCE_DATE_EPOCH / 86400)) \
    && sed -i "s|^colortrace:!:[^:]*:|colortrace:!:${source_date_days}:|" /etc/shadow \
    && grep -Fqx "colortrace:!:${source_date_days}:0:99999:7:::" /etc/shadow \
    && install -d -o 65532 -g 65532 -m 0700 /run/colortrace-private /tmp/colortrace \
    && install -d -o 0 -g 0 -m 0555 /opt/colortrace-config \
    && printf '%s\n' \
        "{\"schema\":\"colortrace-runtime-build-binding/v1\",\"source_commit\":\"${SOURCE_COMMIT}\",\"source_tree\":\"${SOURCE_TREE}\"}" \
        > /opt/colortrace-config/build-binding.json \
    && chmod 0444 /opt/colortrace-config/build-binding.json
COPY --from=build /source/.venv /opt/colortrace
COPY --from=build /opt/colortrace-fixture /opt/colortrace/fixture
COPY packages/fixture-generator/fixtures/canonical-digests.json \
    /opt/colortrace-config/fixture-canonical-digests.json
COPY config/demo/local-demo.json /opt/colortrace-config/demo/local-demo.json
COPY config/grafana-mcp/mcp-grafana.lock.json \
    config/grafana-mcp/query-catalog.json \
    /opt/colortrace-config/grafana-mcp/
COPY config/investigation/investigation-policy.json \
    config/investigation/model-profile.json \
    /opt/colortrace-config/investigation/
COPY uv.lock /opt/colortrace-config/uv.lock
COPY deploy/runtime-entrypoint.py /usr/local/libexec/colortrace-entrypoint.py
COPY packages/repo-tools/src/colortrace_repo/image_licenses.py /usr/local/libexec/colortrace-image-licenses.py
COPY LICENSE /usr/share/licenses/colortrace/LICENSE
RUN chmod 0555 /usr/local/libexec/colortrace-entrypoint.py \
    /usr/local/libexec/colortrace-image-licenses.py \
    && chmod 0444 \
        /opt/colortrace-config/fixture-canonical-digests.json \
        /opt/colortrace-config/demo/local-demo.json \
        /opt/colortrace-config/build-binding.json \
        /opt/colortrace-config/grafana-mcp/mcp-grafana.lock.json \
        /opt/colortrace-config/grafana-mcp/query-catalog.json \
        /opt/colortrace-config/investigation/investigation-policy.json \
        /opt/colortrace-config/investigation/model-profile.json \
        /opt/colortrace-config/uv.lock \
    && find /opt/colortrace/fixture -type d -exec chmod 0555 {} + \
    && find /opt/colortrace/fixture -type f -exec chmod 0444 {} + \
    && /opt/colortrace/bin/python -c "import colortrace_api, colortrace_grafana_mcp, colortrace_simulator"
LABEL org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.colortrace.source-tree="${SOURCE_TREE}"
ENV HOME=/tmp/colortrace \
    PATH=/opt/colortrace/bin:/usr/local/bin:/usr/bin:/bin \
    PYTHONUNBUFFERED=1
USER colortrace
EXPOSE 8080
ENTRYPOINT ["python", "/usr/local/libexec/colortrace-entrypoint.py"]
CMD ["api"]

FROM runtime-base AS runtime
ARG SOURCE_COMMIT
ARG SOURCE_TREE
ARG SOURCE_DATE_EPOCH
USER root
COPY --from=mcp-grafana /usr/local/bin/mcp-grafana /usr/local/bin/mcp-grafana
COPY --from=mcp-grafana /tmp/mcp-grafana.LICENSE /usr/share/licenses/mcp-grafana/LICENSE
COPY --from=mcp-grafana /tmp/go.LICENSE /usr/share/licenses/go/LICENSE
RUN test "$(/usr/local/bin/mcp-grafana --version)" = 1.1.0 \
    && echo "a3dacdcace8d8082dd7cb245e41be54e8da4a9375969cb39c85c420a30ea0809  /usr/local/bin/mcp-grafana" | sha256sum -c - \
    && python /usr/local/libexec/colortrace-image-licenses.py runtime \
        --output /usr/share/colortrace/licenses \
        --profile private-full \
        --source-commit "$SOURCE_COMMIT" \
        --source-tree "$SOURCE_TREE" \
        --base-image python@sha256:a190708a2dec1bd18b1decb539f8e8f5407abaa9bf39cacda583f7f8c11db322 \
        --root-license /usr/share/licenses/colortrace/LICENSE \
        --apk-database /lib/apk/db/installed \
        --os-release /usr/lib/os-release \
        --python-site-packages /opt/colortrace/lib/python3.12/site-packages \
        --global-python-site-packages /usr/local/lib/python3.12/site-packages \
        --ensurepip-wheel /usr/local/lib/python3.12/ensurepip/_bundled/pip-25.0.1-py3-none-any.whl \
        --python-license /usr/local/lib/python3.12/LICENSE.txt \
        --uv-lock /opt/colortrace-config/uv.lock \
        --mcp-binary /usr/local/bin/mcp-grafana \
        --mcp-lock /opt/colortrace-config/grafana-mcp/mcp-grafana.lock.json \
        --mcp-license /usr/share/licenses/mcp-grafana/LICENSE \
        --go-license /usr/share/licenses/go/LICENSE
LABEL org.colortrace.runtime-profile="private-full"
USER colortrace

FROM python@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2 AS reference-worker-build
COPY --from=uv /uv /uvx /usr/local/bin/
WORKDIR /source
COPY pyproject.toml uv.lock LICENSE ./
COPY packages/api/pyproject.toml packages/api/pyproject.toml
COPY packages/evaluation/pyproject.toml packages/evaluation/pyproject.toml
COPY packages/fixture-generator/pyproject.toml packages/fixture-generator/pyproject.toml
COPY packages/grafana-mcp/pyproject.toml packages/grafana-mcp/pyproject.toml
COPY packages/investigation/pyproject.toml packages/investigation/pyproject.toml
COPY packages/recovery/pyproject.toml packages/recovery/pyproject.toml
COPY packages/repo-tools/pyproject.toml packages/repo-tools/pyproject.toml
COPY packages/response-plans/pyproject.toml packages/response-plans/pyproject.toml
COPY packages/simulator/pyproject.toml packages/simulator/pyproject.toml
COPY packages/telemetry/pyproject.toml packages/telemetry/pyproject.toml
COPY packages/validators/pyproject.toml packages/validators/pyproject.toml
COPY packages/vertical-slice/pyproject.toml packages/vertical-slice/pyproject.toml
ENV PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=0 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/colortrace
RUN --mount=type=cache,id=colortrace-reference-worker-uv,target=/root/.cache/uv,sharing=locked \
    uv sync --frozen --no-dev --no-editable --no-install-workspace \
        --package colortrace-simulator --extra reference-worker
COPY packages/fixture-generator/ packages/fixture-generator/
COPY packages/response-plans/ packages/response-plans/
COPY packages/simulator/ packages/simulator/
COPY packages/validators/ packages/validators/
RUN --mount=type=cache,id=colortrace-reference-worker-uv,target=/root/.cache/uv,sharing=locked \
    uv sync --frozen --no-dev --no-editable \
        --package colortrace-simulator --extra reference-worker \
    && /opt/colortrace/bin/python -c \
        "import OpenImageIO, PyOpenColorIO, colortrace_simulator.reference_worker" \
    && /opt/colortrace/bin/colortrace-reference-worker --help >/dev/null \
    && test -z "$(find /opt/colortrace -type f -name '*.py[co]' -print -quit)"

FROM python@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2 AS reference-worker
ARG SOURCE_COMMIT
ARG SOURCE_TREE
ARG SOURCE_DATE_EPOCH
ENV PATH=/opt/colortrace/bin:/usr/local/bin:/usr/bin:/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
RUN case "$SOURCE_COMMIT" in (*[!0-9a-f]*|'') exit 1;; esac \
    && test "${#SOURCE_COMMIT}" = 40 \
    && case "$SOURCE_TREE" in (*[!0-9a-f]*|'') exit 1;; esac \
    && test "${#SOURCE_TREE}" = 40 \
    && case "$SOURCE_DATE_EPOCH" in (*[!0-9]*|'') exit 1;; esac \
    && install -d -o 65532 -g 65532 -m 0700 \
        /work /work/source /work/config /work/output /work/jobs \
    && install -d -o 0 -g 0 -m 0555 /usr/share/licenses/colortrace
COPY --from=reference-worker-build /opt/colortrace /opt/colortrace
COPY LICENSE /usr/share/licenses/colortrace/LICENSE
RUN /opt/colortrace/bin/python -c \
        "import OpenImageIO, PyOpenColorIO, colortrace_simulator.reference_worker" \
    && test "$(/opt/colortrace/bin/python -c 'import OpenImageIO; print(OpenImageIO.VERSION_STRING)')" = 3.1.17.0 \
    && test "$(/opt/colortrace/bin/python -c 'import PyOpenColorIO; print(PyOpenColorIO.__version__)')" = 2.5.2 \
    && /opt/colortrace/bin/colortrace-reference-worker --help >/dev/null \
    && chown -R 65532:65532 /work \
    && chmod 0700 /work /work/source /work/config /work/output /work/jobs \
    && chmod 0444 /usr/share/licenses/colortrace/LICENSE
LABEL org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.colortrace.source-tree="${SOURCE_TREE}" \
      org.colortrace.runtime-profile="reference-worker"
WORKDIR /work
USER 65532:65532
ENTRYPOINT ["/opt/colortrace/bin/colortrace-reference-worker"]

FROM runtime AS default
