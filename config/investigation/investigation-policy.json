{
  "schema": "investigation-policy/v1",
  "policy_version": "bounded-investigation/v1",
  "claim_policy": "deterministic-claim/v1",
  "scope_policy": "single-causal-resource-scope/v1",
  "budgets": {
    "end_to_end_seconds": 120,
    "maximum_model_turns": 6,
    "maximum_input_tokens": 32000,
    "maximum_output_tokens": 4096,
    "maximum_mcp_attempts": 8,
    "maximum_validator_calls": 6,
    "maximum_calls_in_flight": 2,
    "model_timeout_seconds": 45,
    "evidence_timeout_seconds": 20,
    "maximum_trusted_transient_retries": 1,
    "maximum_model_visible_bytes": 1048576,
    "maximum_hypotheses": 4
  },
  "window": {
    "seconds_before_alert": 300,
    "seconds_after_alert": 300,
    "maximum_seconds": 600,
    "maximum_clock_skew_seconds": 5,
    "operational_freshness_seconds": 300
  },
  "required_query_keys": [
    "alert.rule",
    "log.correlated-events",
    "metric.correlated-observations",
    "trace.by-id"
  ],
  "hypothesis_keys": [
    "color-resource-drift",
    "nominal-config-drift",
    "unrelated-event",
    "worker-only-failure"
  ],
  "trusted_transient_errors": [
    "rate_limit",
    "service",
    "timeout",
    "transport"
  ],
  "terminal_no_action_reasons": [
    "budget-exhausted",
    "contradictory-evidence",
    "evidence-unavailable",
    "incomplete-evidence",
    "invalid-intake",
    "model-unavailable",
    "no-affected-targets",
    "policy-drift",
    "stale-evidence",
    "validator-unresolved"
  ]
}
