#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

readonly PROJECT_ID='${project_id}'
readonly REGION='${region}'
readonly REGISTRY_HOST='${registry_host}'
readonly ACCESS_SECRET_ID='${access_secret_id}'
readonly ACCESS_SECRET_VERSION='${access_secret_version}'
readonly STAGING_GENERATION='${staging_generation}'
readonly STAGING_LIFETIME_HOURS='${staging_lifetime_hours}'
readonly COMPOSE_B64='${compose_yaml_base64}'
readonly CADDYFILE_B64='${caddyfile_base64}'
readonly GRAFANA_ALERTING_B64='${grafana_alerting_base64}'
readonly GRAFANA_DATASOURCES_B64='${grafana_datasources_base64}'
readonly LOKI_CONFIG_B64='${loki_config_base64}'
readonly PROMETHEUS_CONFIG_B64='${prometheus_config_base64}'
readonly TEMPO_CONFIG_B64='${tempo_config_base64}'
readonly ROOT_DIR='/srv/colortrace'
readonly CONTROL_DIR='/var/lib/colortrace-lifecycle'
readonly STATES_DIR="$CONTROL_DIR/states"
readonly METADATA_URL='http://metadata.google.internal/computeMetadata/v1'
readonly METADATA_IP='169.254.169.254'
readonly RUNTIME_CONTAINER_IP='172.30.0.10'
readonly REQUIRED_PACKAGES='ca-certificates curl docker-compose docker.io iptables jq openssl'
readonly APT_AUTOMATIC_TIMERS='apt-daily.timer apt-daily-upgrade.timer'
readonly APT_AUTOMATIC_SERVICES='apt-daily.service apt-daily-upgrade.service'
readonly APT_AUTOMATIC_UNITS="$APT_AUTOMATIC_TIMERS $APT_AUTOMATIC_SERVICES"
readonly APT_SERVICE_QUIESCE_ATTEMPTS=180
readonly APT_SERVICE_QUIESCE_DELAY_SECONDS=5
readonly LIFECYCLE_STATE_VERSION='1'

startup_complete=false
registry_login_active=false

cleanup_runtime_credentials() {
  rm -f "$ROOT_DIR/secrets/grafana.netrc" >/dev/null 2>&1 || true
  if test "$registry_login_active" = true; then
    docker logout "$REGISTRY_HOST" >/dev/null 2>&1 || true
  fi
}

fail_closed() {
  local status=$1
  trap - ERR EXIT HUP INT TERM
  cleanup_runtime_credentials
  if test "$status" -eq 0; then
    status=1
  fi
  systemctl poweroff >/dev/null 2>&1 \
    || poweroff --force >/dev/null 2>&1 \
    || shutdown --poweroff now >/dev/null 2>&1 \
    || true
  exit "$status"
}

finish_startup() {
  local status=$1
  trap - ERR EXIT HUP INT TERM
  cleanup_runtime_credentials
  if test "$startup_complete" != true; then
    fail_closed "$status"
  fi
  exit "$status"
}

trap 'fail_closed $?' ERR
trap 'finish_startup $?' EXIT
trap 'fail_closed 1' HUP INT TERM

lifecycle_error() {
  printf 'Invalid or interrupted ColorTrace lifecycle state.\n' >&2
  return 1
}

freeze_automatic_apt() {
  local active_state
  local apt_services_inactive
  local attempt
  local enabled_state
  local unit

  systemctl mask $APT_AUTOMATIC_UNITS || lifecycle_error
  systemctl stop $APT_AUTOMATIC_TIMERS || lifecycle_error

  apt_services_inactive=false
  for ((attempt = 0; attempt < APT_SERVICE_QUIESCE_ATTEMPTS; attempt += 1)); do
    apt_services_inactive=true
    for unit in $APT_AUTOMATIC_SERVICES; do
      active_state=$(systemctl show "$unit" --property=ActiveState --value 2>/dev/null || true)
      if test "$active_state" != inactive; then
        apt_services_inactive=false
      fi
    done
    if test "$apt_services_inactive" = true; then
      break
    fi
    sleep "$APT_SERVICE_QUIESCE_DELAY_SECONDS"
  done
  test "$apt_services_inactive" = true || lifecycle_error

  for unit in $APT_AUTOMATIC_UNITS; do
    enabled_state=$(systemctl is-enabled "$unit" 2>/dev/null || true)
    active_state=$(systemctl is-active "$unit" 2>/dev/null || true)
    test "$enabled_state" = masked || lifecycle_error
    test "$active_state" = inactive || lifecycle_error
  done
}

freeze_automatic_apt

read_record_value() {
  local path=$1
  local destination=$2
  local value
  local size

  test -f "$path" && ! test -L "$path" || lifecycle_error
  value=$(cat "$path") || lifecycle_error
  size=$(stat -c '%s' "$path")
  if test "$size" -eq "$${#value}"; then
    printf '%s' "$value" | cmp --silent - "$path" || lifecycle_error
  elif test "$size" -eq "$(( $${#value} + 1 ))"; then
    printf '%s\n' "$value" | cmp --silent - "$path" || lifecycle_error
  else
    lifecycle_error
  fi
  printf -v "$destination" '%s' "$value"
}

validate_generation_value() {
  local generation=$1
  [[ "$generation" =~ ^[a-z0-9][a-z0-9-]{6,30}[a-z0-9]$ ]] || lifecycle_error
}

validate_activation_value() {
  local activation=$1
  case "$activation" in
    ''|*[!0-9]*) lifecycle_error ;;
  esac
}

installed_package_versions() {
  local package
  local package_status
  local inventory_name
  local inventory_status
  local inventory_version

  for package in $REQUIRED_PACKAGES; do
    package_status=$(dpkg-query \
      --show \
      --showformat='$${db:Status-Abbrev}|$${Version}' \
      "$package") || lifecycle_error
    case "$package_status" in
      'ii '*) ;;
      *) lifecycle_error; return 1 ;;
    esac
  done

  dpkg-query \
    --show \
    --showformat='$${db:Status-Abbrev}|$${binary:Package}|$${Version}\n' \
    | while IFS='|' read -r inventory_status inventory_name inventory_version; do
      case "$inventory_status" in
        'ii ') ;;
        *) continue ;;
      esac
      case "$inventory_name" in
        ''|*=*|*[[:space:]]*) lifecycle_error; return 1 ;;
      esac
      case "$inventory_version" in
        ''|*[[:space:]]*) lifecycle_error; return 1 ;;
      esac
      printf '%s=%s\n' "$inventory_name" "$inventory_version"
    done \
    | LC_ALL=C sort
}

validate_package_record() {
  local state_dir=$1
  local installed_versions

  test -s "$state_dir/package-versions" \
    && test -f "$state_dir/package-versions" \
    && ! test -L "$state_dir/package-versions" \
    || lifecycle_error
  test "$(stat -c '%a' "$state_dir/package-versions")" = 400 \
    || lifecycle_error
  installed_versions=$(installed_package_versions) || lifecycle_error
  printf '%s\n' "$installed_versions" \
    | cmp --silent - "$state_dir/package-versions" \
    || lifecycle_error
}

validate_managed_state() {
  local state_dir=$1
  local state_name=$2
  local state_version

  test -d "$state_dir" && ! test -L "$state_dir" || lifecycle_error
  test "$(stat -c '%a' "$state_dir")" = 700 || lifecycle_error
  test "$(stat -c '%a' "$state_dir/state-version")" = 400 \
    || lifecycle_error
  test "$(stat -c '%a' "$state_dir/generation")" = 400 \
    || lifecycle_error
  test "$(stat -c '%a' "$state_dir/activated-at")" = 400 \
    || lifecycle_error
  read_record_value "$state_dir/state-version" state_version
  read_record_value "$state_dir/generation" existing_generation
  read_record_value "$state_dir/activated-at" existing_activated_at
  test "$state_version" = "$LIFECYCLE_STATE_VERSION" || lifecycle_error
  validate_generation_value "$existing_generation"
  validate_activation_value "$existing_activated_at"
  test "$state_name" = "$existing_generation-$existing_activated_at" \
    || lifecycle_error
  validate_package_record "$state_dir"
}

accept_generation_state() {
  local generation=$1
  local activation=$2
  local state_name="$generation-$activation"
  local temporary_state="$STATES_DIR/.state-new-$generation-$activation-$$"
  local temporary_link="$CONTROL_DIR/.current-new-$$"

  test ! -e "$temporary_state" && ! test -L "$temporary_state" \
    || lifecycle_error
  test ! -e "$STATES_DIR/$state_name" \
    && ! test -L "$STATES_DIR/$state_name" \
    || lifecycle_error
  install -d -m 0700 "$temporary_state"
  printf '%s' "$LIFECYCLE_STATE_VERSION" >"$temporary_state/state-version"
  printf '%s' "$generation" >"$temporary_state/generation"
  printf '%s' "$activation" >"$temporary_state/activated-at"
  chmod 0400 \
    "$temporary_state/state-version" \
    "$temporary_state/generation" \
    "$temporary_state/activated-at"
  sync \
    "$temporary_state/state-version" \
    "$temporary_state/generation" \
    "$temporary_state/activated-at" \
    "$temporary_state"
  mv -T "$temporary_state" "$STATES_DIR/$state_name"
  sync "$STATES_DIR"
  ln -s "states/$state_name" "$temporary_link"
  mv -Tf "$temporary_link" "$CONTROL_DIR/current"
  sync "$CONTROL_DIR"
  active_state_dir="$STATES_DIR/$state_name"
}

install_compatibility_links() {
  local generation_link="$CONTROL_DIR/.generation-link-new-$$"
  local activation_link="$CONTROL_DIR/.activated-link-new-$$"

  ln -s 'current/generation' "$generation_link"
  ln -s 'current/activated-at' "$activation_link"
  if test "$legacy_state" = true; then
    mv -T "$CONTROL_DIR/generation" "$CONTROL_DIR/.legacy-generation-$$"
    mv -T "$CONTROL_DIR/activated-at" "$CONTROL_DIR/.legacy-activated-at-$$"
  fi
  mv -Tf "$generation_link" "$CONTROL_DIR/generation"
  mv -Tf "$activation_link" "$CONTROL_DIR/activated-at"
  sync "$CONTROL_DIR"
  if test "$legacy_state" = true; then
    rm -f \
      "$CONTROL_DIR/.legacy-generation-$$" \
      "$CONTROL_DIR/.legacy-activated-at-$$"
  fi
}

record_installed_packages() {
  local installed_versions
  local temporary_record="$active_state_dir/.packages-new-$$"

  installed_versions=$(installed_package_versions) || lifecycle_error
  printf '%s\n' "$installed_versions" >"$temporary_record"
  chmod 0400 "$temporary_record"
  sync "$temporary_record" "$active_state_dir"
  mv -T "$temporary_record" "$active_state_dir/package-versions"
  sync "$active_state_dir"
}

fresh_lifecycle=false
if test -e "$CONTROL_DIR" || test -L "$CONTROL_DIR"; then
  test -d "$CONTROL_DIR" && ! test -L "$CONTROL_DIR" || lifecycle_error
else
  install -d -m 0700 "$CONTROL_DIR"
  fresh_lifecycle=true
fi
if test -e "$STATES_DIR" || test -L "$STATES_DIR"; then
  test -d "$STATES_DIR" && ! test -L "$STATES_DIR" || lifecycle_error
else
  install -d -m 0700 "$STATES_DIR"
fi
test "$(stat -c '%a' "$STATES_DIR")" = 700 || lifecycle_error
validate_generation_value "$STAGING_GENERATION"
case "$STAGING_LIFETIME_HOURS" in
  ''|*[!0-9]*) lifecycle_error ;;
esac
test "$STAGING_LIFETIME_HOURS" -eq 168 || lifecycle_error

unexpected_lifecycle_entry=$(find "$CONTROL_DIR" -mindepth 1 -maxdepth 1 \
  ! \( -name states \
  -o -name current \
  -o -name generation \
  -o -name activated-at \) \
  -print -quit)
test -z "$unexpected_lifecycle_entry" || lifecycle_error

interrupted_state=$(find "$CONTROL_DIR" -mindepth 1 -maxdepth 3 \
  \( -name '.state-new-*' \
  -o -name '.current-new-*' \
  -o -name '.generation-link-new-*' \
  -o -name '.activated-link-new-*' \
  -o -name '.legacy-generation-*' \
  -o -name '.legacy-activated-at-*' \
  -o -name '.packages-new-*' \) \
  -print -quit)
test -z "$interrupted_state" || lifecycle_error

legacy_state=false
generation_requires_packages=false
active_state_dir=''
existing_generation=''
existing_activated_at=''
if test -L "$CONTROL_DIR/current"; then
  test -L "$CONTROL_DIR/generation" \
    && test "$(readlink "$CONTROL_DIR/generation")" = 'current/generation' \
    || lifecycle_error
  test -L "$CONTROL_DIR/activated-at" \
    && test "$(readlink "$CONTROL_DIR/activated-at")" = 'current/activated-at' \
    || lifecycle_error
  current_target=$(readlink "$CONTROL_DIR/current")
  case "$current_target" in
    states/*) ;;
    *) lifecycle_error ;;
  esac
  state_name=$${current_target#states/}
  case "$state_name" in
    ''|.*|*/*) lifecycle_error ;;
  esac
  active_state_dir="$CONTROL_DIR/$current_target"
  validate_managed_state "$active_state_dir" "$state_name"
elif test -e "$CONTROL_DIR/current"; then
  lifecycle_error
elif test -f "$CONTROL_DIR/generation" \
  && ! test -L "$CONTROL_DIR/generation" \
  && test -f "$CONTROL_DIR/activated-at" \
  && ! test -L "$CONTROL_DIR/activated-at"; then
  legacy_state=true
  read_record_value "$CONTROL_DIR/generation" existing_generation
  read_record_value "$CONTROL_DIR/activated-at" existing_activated_at
  validate_generation_value "$existing_generation"
  validate_activation_value "$existing_activated_at"
  test -z "$(find "$STATES_DIR" -mindepth 1 -print -quit)" || lifecycle_error
elif test ! -e "$CONTROL_DIR/generation" \
  && ! test -L "$CONTROL_DIR/generation" \
  && test ! -e "$CONTROL_DIR/activated-at" \
  && ! test -L "$CONTROL_DIR/activated-at"; then
  test "$fresh_lifecycle" = true || lifecycle_error
  test -z "$(find "$STATES_DIR" -mindepth 1 -print -quit)" || lifecycle_error
else
  lifecycle_error
fi

now=$(date +%s)
validate_activation_value "$now"
if test -n "$existing_activated_at" && test "$existing_activated_at" -gt "$now"; then
  lifecycle_error
fi

if test "$existing_generation" != "$STAGING_GENERATION"; then
  activated_at=$now
  accept_generation_state "$STAGING_GENERATION" "$activated_at"
  install_compatibility_links
  generation_requires_packages=true
else
  activated_at=$existing_activated_at
  if test "$legacy_state" = true; then
    accept_generation_state "$existing_generation" "$activated_at"
    install_compatibility_links
    generation_requires_packages=true
  fi
fi

deadline=$((activated_at + STAGING_LIFETIME_HOURS * 3600))
test "$deadline" -gt "$activated_at" || lifecycle_error
now=$(date +%s)
validate_activation_value "$now"
remaining=$((deadline - now))

if test "$remaining" -le 0; then
  fail_closed 1
fi
systemctl stop colortrace-auto-stop.timer colortrace-auto-stop.service >/dev/null 2>&1 || true
systemctl reset-failed colortrace-auto-stop.timer colortrace-auto-stop.service >/dev/null 2>&1 || true
systemd-run \
  --collect \
  --unit=colortrace-auto-stop \
  --on-calendar="@$deadline" \
  --timer-property=AccuracySec=1s \
  --timer-property=Persistent=yes \
  /usr/bin/systemctl poweroff
systemctl is-active --quiet colortrace-auto-stop.timer
test "$(systemctl show colortrace-auto-stop.timer \
  --property=Persistent --value)" = yes
test "$(systemctl show colortrace-auto-stop.timer \
  --property=AccuracyUSec --value)" = 1s
timer_deadline=$(systemctl show --timestamp=unix colortrace-auto-stop.timer \
  --property=NextElapseUSecRealtime --value)
test -n "$timer_deadline"
timer_deadline_epoch=$(date --date="$timer_deadline" +%s)
validate_activation_value "$timer_deadline_epoch"
test "$timer_deadline_epoch" -eq "$deadline"

export DEBIAN_FRONTEND=noninteractive
if test "$generation_requires_packages" = true; then
  if test "$legacy_state" != true \
    || test "$existing_generation" != "$STAGING_GENERATION"; then
    apt-get update
    apt-get install --yes --no-install-recommends $REQUIRED_PACKAGES
  fi
  record_installed_packages
fi
systemctl enable --now docker

configure_container_metadata_boundary() {
  while iptables --wait 5 --delete DOCKER-USER \
    --source "$RUNTIME_CONTAINER_IP/32" \
    --destination "$METADATA_IP/32" \
    --jump ACCEPT >/dev/null 2>&1; do :; done
  while iptables --wait 5 --delete DOCKER-USER \
    --destination "$METADATA_IP/32" \
    --jump DROP >/dev/null 2>&1; do :; done

  iptables --wait 5 --insert DOCKER-USER 1 \
    --destination "$METADATA_IP/32" \
    --jump DROP
  iptables --wait 5 --insert DOCKER-USER 1 \
    --source "$RUNTIME_CONTAINER_IP/32" \
    --destination "$METADATA_IP/32" \
    --jump ACCEPT

  iptables --wait 5 --check DOCKER-USER \
    --source "$RUNTIME_CONTAINER_IP/32" \
    --destination "$METADATA_IP/32" \
    --jump ACCEPT
  iptables --wait 5 --check DOCKER-USER \
    --destination "$METADATA_IP/32" \
    --jump DROP
}

configure_container_metadata_boundary

install -d -m 0755 "$ROOT_DIR"
install -d -m 0700 \
  "$ROOT_DIR/app" \
  "$ROOT_DIR/config" \
  "$ROOT_DIR/grafana" \
  "$ROOT_DIR/loki" \
  "$ROOT_DIR/prometheus" \
  "$ROOT_DIR/secrets"
install -d -o 65532 -g 65532 -m 0700 \
  "$ROOT_DIR/app/simulator-workspace" \
  "$ROOT_DIR/caddy-config" \
  "$ROOT_DIR/caddy-data"
install -d -o 10001 -g 10001 -m 0700 "$ROOT_DIR/loki" "$ROOT_DIR/tempo"
install -d -o 472 -g 472 -m 0700 "$ROOT_DIR/grafana"
install -d -o 65534 -g 65534 -m 0700 "$ROOT_DIR/prometheus"
chown -R 65532:65532 "$ROOT_DIR/app"
chown -R 65532:65532 "$ROOT_DIR/caddy-config" "$ROOT_DIR/caddy-data"
chown -R 10001:10001 "$ROOT_DIR/loki" "$ROOT_DIR/tempo"
chown -R 472:472 "$ROOT_DIR/grafana"
chown -R 65534:65534 "$ROOT_DIR/prometheus"

metadata_token() {
  curl \
    --fail \
    --silent \
    --show-error \
    --header 'Metadata-Flavor: Google' \
    "$METADATA_URL/instance/service-accounts/default/token" \
    | jq -er '.access_token'
}

cloud_token=$(metadata_token)
secret_payload=$(curl \
  --fail \
  --silent \
  --show-error \
  --header "Authorization: Bearer $cloud_token" \
  "https://secretmanager.googleapis.com/v1/projects/$PROJECT_ID/secrets/$ACCESS_SECRET_ID/versions/$ACCESS_SECRET_VERSION:access" \
  | jq -er '.payload.data')
access_hash=$(printf '%s' "$secret_payload" | base64 --decode)
unset secret_payload

case "$access_hash" in
  '$2a$'*|'$2b$'*|'$2y$'*) ;;
  *) exit 1 ;;
esac
if test "$(printf '%s' "$access_hash" | wc -c)" -ne 60; then
  exit 1
fi

printf '%s' "$COMPOSE_B64" | base64 --decode >"$ROOT_DIR/config/compose.yaml.new"
printf '%s' "$CADDYFILE_B64" | base64 --decode >"$ROOT_DIR/config/Caddyfile.template"
printf '%s' "$GRAFANA_ALERTING_B64" | base64 --decode >"$ROOT_DIR/config/grafana-alerting.yaml.new"
printf '%s' "$GRAFANA_DATASOURCES_B64" | base64 --decode >"$ROOT_DIR/config/grafana-datasources.yaml.new"
printf '%s' "$LOKI_CONFIG_B64" | base64 --decode >"$ROOT_DIR/config/loki.yaml.new"
printf '%s' "$PROMETHEUS_CONFIG_B64" | base64 --decode >"$ROOT_DIR/config/prometheus.yaml.new"
printf '%s' "$TEMPO_CONFIG_B64" | base64 --decode >"$ROOT_DIR/config/tempo.yaml.new"
sed "s|__COLORTRACE_ACCESS_HASH__|$access_hash|" \
  "$ROOT_DIR/config/Caddyfile.template" >"$ROOT_DIR/config/Caddyfile.new"
unset access_hash
if grep --quiet '__COLORTRACE_ACCESS_HASH__' "$ROOT_DIR/config/Caddyfile.new"; then
  exit 1
fi
mv "$ROOT_DIR/config/compose.yaml.new" "$ROOT_DIR/config/compose.yaml"
mv "$ROOT_DIR/config/Caddyfile.new" "$ROOT_DIR/config/Caddyfile"
mv "$ROOT_DIR/config/grafana-alerting.yaml.new" "$ROOT_DIR/config/grafana-alerting.yaml"
mv "$ROOT_DIR/config/grafana-datasources.yaml.new" "$ROOT_DIR/config/grafana-datasources.yaml"
mv "$ROOT_DIR/config/loki.yaml.new" "$ROOT_DIR/config/loki.yaml"
mv "$ROOT_DIR/config/prometheus.yaml.new" "$ROOT_DIR/config/prometheus.yaml"
mv "$ROOT_DIR/config/tempo.yaml.new" "$ROOT_DIR/config/tempo.yaml"
rm -f "$ROOT_DIR/config/Caddyfile.template"
chmod 0600 "$ROOT_DIR/config/compose.yaml" "$ROOT_DIR/config/Caddyfile"
chmod 0444 \
  "$ROOT_DIR/config/grafana-alerting.yaml" \
  "$ROOT_DIR/config/grafana-datasources.yaml" \
  "$ROOT_DIR/config/loki.yaml" \
  "$ROOT_DIR/config/prometheus.yaml" \
  "$ROOT_DIR/config/tempo.yaml"
chown 65532:65532 "$ROOT_DIR/config/Caddyfile"
chmod 0400 "$ROOT_DIR/config/Caddyfile"
test "$(stat -c '%u:%g:%a' "$ROOT_DIR/config/Caddyfile")" = "65532:65532:400"
test "$(stat -c '%u:%g:%a' "$ROOT_DIR/caddy-data")" = "65532:65532:700"
test "$(stat -c '%u:%g:%a' "$ROOT_DIR/caddy-config")" = "65532:65532:700"

if ! test -s "$ROOT_DIR/secrets/grafana-admin-password"; then
  openssl rand -hex 32 >"$ROOT_DIR/secrets/grafana-admin-password.new"
  mv "$ROOT_DIR/secrets/grafana-admin-password.new" \
    "$ROOT_DIR/secrets/grafana-admin-password"
fi
chmod 0600 "$ROOT_DIR/secrets/grafana-admin-password"
grafana_admin_password=$(cat "$ROOT_DIR/secrets/grafana-admin-password")
printf '%s\n' \
  'GF_SECURITY_ADMIN_USER=colortrace-admin' \
  "GF_SECURITY_ADMIN_PASSWORD=$grafana_admin_password" \
  >"$ROOT_DIR/config/grafana.env.new"
unset grafana_admin_password
mv "$ROOT_DIR/config/grafana.env.new" "$ROOT_DIR/config/grafana.env"
chown 472:472 "$ROOT_DIR/config/grafana.env"
chmod 0400 "$ROOT_DIR/config/grafana.env"

compose() {
  if docker compose version >/dev/null 2>&1; then
    docker compose --file "$ROOT_DIR/config/compose.yaml" "$@"
  else
    docker-compose --file "$ROOT_DIR/config/compose.yaml" "$@"
  fi
}

compose config --quiet
compose down --remove-orphans
printf '%s' "$cloud_token" \
  | docker login --username oauth2accesstoken --password-stdin "$REGISTRY_HOST"
registry_login_active=true
compose pull
compose up --detach --remove-orphans grafana loki prometheus tempo caddy

grafana_ready=false
backends_ready=false
for _ in $(seq 1 90); do
  if curl --fail --silent --show-error \
    http://127.0.0.1:13000/api/health >/dev/null; then
    grafana_ready=true
  fi
  if curl --fail --silent --show-error http://127.0.0.1:13100/ready >/dev/null \
    && curl --fail --silent --show-error http://127.0.0.1:13200/ready >/dev/null \
    && curl --fail --silent --show-error http://127.0.0.1:19090/-/ready >/dev/null; then
    backends_ready=true
  fi
  if test "$grafana_ready" = true && test "$backends_ready" = true; then
    break
  fi
  sleep 2
done
if test "$grafana_ready" != true || test "$backends_ready" != true; then
  compose ps
  exit 1
fi

grafana_admin_password=$(cat "$ROOT_DIR/secrets/grafana-admin-password")
printf '%s\n' \
  'machine 127.0.0.1' \
  'login colortrace-admin' \
  "password $grafana_admin_password" \
  >"$ROOT_DIR/secrets/grafana.netrc"
unset grafana_admin_password
chmod 0600 "$ROOT_DIR/secrets/grafana.netrc"

for datasource_uid in prometheus loki tempo; do
  datasource_ready=false
  for _ in $(seq 1 30); do
    if curl \
      --fail \
      --silent \
      --show-error \
      --netrc-file "$ROOT_DIR/secrets/grafana.netrc" \
      "http://127.0.0.1:13000/api/datasources/uid/$datasource_uid/health" \
      | jq -e '.status == "OK"' >/dev/null; then
      datasource_ready=true
      break
    fi
    sleep 2
  done
  if test "$datasource_ready" != true; then
    exit 1
  fi
done

curl \
  --fail \
  --silent \
  --show-error \
  --netrc-file "$ROOT_DIR/secrets/grafana.netrc" \
  --get \
  --data-urlencode 'query=vector(1)' \
  http://127.0.0.1:13000/api/datasources/proxy/uid/prometheus/api/v1/query \
  | jq -e '.status == "success" and (.data.result | length) == 1' >/dev/null
curl \
  --fail \
  --silent \
  --show-error \
  --netrc-file "$ROOT_DIR/secrets/grafana.netrc" \
  --get \
  --data-urlencode 'query=vector(1)' \
  http://127.0.0.1:13000/api/datasources/proxy/uid/loki/loki/api/v1/query \
  | jq -e '.status == "success" and (.data.result | length) == 1' >/dev/null
curl \
  --fail \
  --silent \
  --show-error \
  --netrc-file "$ROOT_DIR/secrets/grafana.netrc" \
  --get \
  --data-urlencode 'limit=1' \
  http://127.0.0.1:13000/api/datasources/proxy/uid/tempo/api/search \
  | jq -e '(.traces | type) == "array"' >/dev/null

if ! test -s "$ROOT_DIR/secrets/grafana-viewer-token"; then
  service_account_body=$(jq -cn \
    --arg name "colortrace-mcp-$STAGING_GENERATION" \
    '{name: $name, role: "Viewer"}')
  service_account_response=$(curl \
    --fail \
    --silent \
    --show-error \
    --netrc-file "$ROOT_DIR/secrets/grafana.netrc" \
    --header 'Content-Type: application/json' \
    --request POST \
    --data "$service_account_body" \
    http://127.0.0.1:13000/api/serviceaccounts)
  service_account_id=$(printf '%s' "$service_account_response" | jq -er '.id')
  token_body=$(jq -cn \
    --arg name "runtime-$STAGING_GENERATION" \
    '{name: $name, secondsToLive: 0}')
  token_response=$(curl \
    --fail \
    --silent \
    --show-error \
    --netrc-file "$ROOT_DIR/secrets/grafana.netrc" \
    --header 'Content-Type: application/json' \
    --request POST \
    --data "$token_body" \
    "http://127.0.0.1:13000/api/serviceaccounts/$service_account_id/tokens")
  grafana_token=$(printf '%s' "$token_response" | jq -er '.key')
  case "$grafana_token" in
    ''|*[[:space:]]*) exit 1 ;;
  esac
  printf '%s' "$grafana_token" >"$ROOT_DIR/secrets/grafana-viewer-token.new"
  unset grafana_token token_response service_account_response
  mv "$ROOT_DIR/secrets/grafana-viewer-token.new" \
    "$ROOT_DIR/secrets/grafana-viewer-token"
  chown 65532:65532 "$ROOT_DIR/secrets/grafana-viewer-token"
  chmod 0600 "$ROOT_DIR/secrets/grafana-viewer-token"
fi
unset cloud_token
rm -f "$ROOT_DIR/secrets/grafana.netrc"

caddy_ca="$ROOT_DIR/caddy-data/caddy/pki/authorities/local/root.crt"
caddy_ca_ready=false
for _ in $(seq 1 60); do
  if test -s "$caddy_ca"; then
    caddy_ca_ready=true
    break
  fi
  sleep 1
done
if test "$caddy_ca_ready" != true; then
  exit 1
fi
install -m 0444 "$caddy_ca" "$ROOT_DIR/config/caddy-root.crt.new"
mv "$ROOT_DIR/config/caddy-root.crt.new" "$ROOT_DIR/config/caddy-root.crt"

compose up --detach runtime web
runtime_ready=false
web_ready=false
for _ in $(seq 1 90); do
  runtime_health=$(docker inspect --format '{{.State.Health.Status}}' colortrace-runtime)
  web_health=$(docker inspect --format '{{.State.Health.Status}}' colortrace-web)
  if test "$runtime_health" = healthy && test "$web_health" = healthy; then
    runtime_ready=true
    web_ready=true
    break
  fi
  if test "$runtime_health" = unhealthy || test "$web_health" = unhealthy; then
    break
  fi
  sleep 2
done
if test "$runtime_ready" != true || test "$web_ready" != true; then
  compose ps
  exit 1
fi
docker exec --user 65532:65532 colortrace-runtime \
  python -c 'import hmac, os, stat; from pathlib import Path; source=Path("/run/colortrace-secrets/grafana-viewer-token"); target=Path("/run/colortrace-private/grafana-viewer-token"); info=target.stat(); assert stat.S_ISREG(info.st_mode); assert info.st_uid == 65532 and info.st_gid == 65532; assert stat.S_IMODE(info.st_mode) == 0o600; assert hmac.compare_digest(source.read_bytes(), target.read_bytes())'
compose ps
startup_complete=true
