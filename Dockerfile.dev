# syntax=docker/dockerfile:1.7.0@sha256:dbbd5e059e8a07ff7ea6233b213b36aa516b4c53c645f1817a4dd18b83cbea56

FROM ghcr.io/astral-sh/uv@sha256:2d890623d310b57771ce840f0da5eed5fc6d657da05ffaa45d82797b53fa3abc AS uv

FROM zricethezav/gitleaks@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f AS gitleaks

FROM node@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03 AS node
RUN corepack disable \
    && npm install --global pnpm@11.21.0 \
    && pnpm --version | grep -Fx 11.21.0

FROM golang@sha256:3889b425f035be855a72fb4755265311293b6d414521f0a519d819df32222d83 AS mcp-grafana
ENV CGO_ENABLED=0 \
    GOARCH=amd64 \
    GOOS=linux \
    GOPROXY=https://proxy.golang.org \
    GOSUMDB=sum.golang.org \
    GOTOOLCHAIN=local
WORKDIR /build
COPY config/grafana-mcp/build/go.mod config/grafana-mcp/build/go.sum \
    config/grafana-mcp/build/modules.txt ./
ADD --checksum=sha256:91bdd1dece9d4aaaf9b5bda899d64f36ca65a37fd7511acbd6d69cd1c6ddbb59 \
    https://codeload.github.com/grafana/mcp-grafana/tar.gz/007e8d82154899a28e19e8dfe9c2bb4452c5211a \
    /tmp/mcp-grafana-source.tar.gz
RUN test "$(go version)" = "go version go1.26.6 linux/amd64" \
    && echo "bec38d3e8473226980e03364209db2a3180782d1f531ede5cb52983c5c9721cc  go.mod" | sha256sum -c - \
    && echo "a793edc44adea4185d8bdef99e522bce47b3341d45d0d4b88723390169bb8f45  go.sum" | sha256sum -c - \
    && echo "29f223acc1d2d9ac9e136d246d934e3c3130d1a57eed002f97a680b20b8050ed  modules.txt" | sha256sum -c - \
    && echo "91bdd1dece9d4aaaf9b5bda899d64f36ca65a37fd7511acbd6d69cd1c6ddbb59  /tmp/mcp-grafana-source.tar.gz" | sha256sum -c - \
    && go mod download all \
    && go list -mod=readonly -m all > /tmp/modules.txt \
    && cmp modules.txt /tmp/modules.txt \
    && tar --extract --gzip --file /tmp/mcp-grafana-source.tar.gz --directory /tmp
RUN --network=none go mod verify \
    && module_root="$(go env GOMODCACHE)/github.com/grafana/mcp-grafana@v1.1.0" \
    && source_root="/tmp/mcp-grafana-007e8d82154899a28e19e8dfe9c2bb4452c5211a" \
    && find "$module_root" -type f -exec sh -eu -c 'module_root=$1; source_root=$2; shift 2; for module_file do relative=${module_file#${module_root}/}; cmp "$module_file" "$source_root/$relative"; done' sh "$module_root" "$source_root" {} + \
    && go build -trimpath -buildvcs=false -mod=readonly \
        -ldflags="-s -w -buildid= -X github.com/grafana/mcp-grafana.version=1.1.0" \
        -o /usr/local/bin/mcp-grafana \
        github.com/grafana/mcp-grafana/cmd/mcp-grafana \
    && test "$(/usr/local/bin/mcp-grafana --version)" = 1.1.0 \
    && echo "5f6b1492ff35f92506e17310b3ea8b689c3f04c1fe0f6d4cc0a1f6e50bd52d93  /usr/local/bin/mcp-grafana" | sha256sum -c -

FROM python@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2 AS terraform
ADD --checksum=sha256:76edd0b22d2f27d3d2e097cd793209646f719cf60f02ff3af626b07361137da1 \
    https://releases.hashicorp.com/terraform/1.15.9/terraform_1.15.9_linux_amd64.zip \
    /tmp/terraform.zip
RUN python -m zipfile --extract /tmp/terraform.zip /tmp/terraform \
    && install --mode 0755 /tmp/terraform/terraform /usr/local/bin/terraform \
    && test "$(terraform version -json | python -c 'import json,sys; print(json.load(sys.stdin)["terraform_version"])')" = 1.15.9

FROM python@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2

RUN apt-get update \
    && apt-get install --yes --no-install-recommends git=1:2.39.5-0+deb12u3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /usr/local/bin/
COPY --from=gitleaks /usr/bin/gitleaks /usr/local/bin/gitleaks
COPY --from=node /usr/local/ /usr/local/
COPY --from=mcp-grafana /usr/local/bin/mcp-grafana /usr/local/bin/mcp-grafana
COPY --from=terraform /usr/local/bin/terraform /usr/local/bin/terraform

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy

WORKDIR /workspace

RUN python --version | grep -F 'Python 3.12.13' \
    && node --version | grep -Fx v24.19.0 \
    && pnpm --version | grep -Fx 11.21.0 \
    && uv --version | grep -F 'uv 0.12.3 ' \
    && git --version | grep -Fx 'git version 2.39.5' \
    && gitleaks version | grep -Fx v8.30.1 \
    && test "$(mcp-grafana --version)" = 1.1.0 \
    && echo "5f6b1492ff35f92506e17310b3ea8b689c3f04c1fe0f6d4cc0a1f6e50bd52d93  /usr/local/bin/mcp-grafana" | sha256sum --check --strict \
    && terraform version -json | python -c 'import json,sys; assert json.load(sys.stdin)["terraform_version"] == "1.15.9"'
